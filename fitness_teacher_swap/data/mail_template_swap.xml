<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="mail_template_teacher_swap" model="mail.template">
            <field name="lang">{{ object.student_id.lang }}</field>
            <field name="name">Fitness: Instructor Change Notification</field>
            <field name="model_id" ref="fitness_bookings.model_fitness_booking"/>
            <field name="subject">{{ 'Your class instructor has changed' if object.student_id.lang == 'en_US' else ("L'instructor/a de la teva classe ha canviat" if object.student_id.lang == 'ca_ES' else 'El/La instructor/a de tu clase ha cambiado') }}</field>
            <field name="partner_to">{{ object.student_id.id }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="email_from">{{ user.company_id.email_formatted or '"CoreLab Studio" &lt;info@corelabstudio.es&gt;' }}</field>
            <field name="reply_to">{{ user.company_id.email_formatted or '"CoreLab Studio" &lt;info@corelabstudio.es&gt;' }}</field>
            <field name="body_html" type="html">
<div style="margin:0;padding:0;font-size:14px;line-height:1.6;color-scheme:light only;supported-color-schemes:light only;background-color:#FAF9F6;color:#2E2724;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;padding:20px 22px;border-radius:10px;">
  <t t-if="object.student_id.lang == 'en_US'">
    <p>Hi <t t-out="object.student_id.name or ''"/>,</p>
    <p>We wanted to let you know that the instructor for your upcoming class has been updated:</p>
    <ul>
      <li>Class: <strong t-out="object.calendar_event_id.name or ''"/></li>
      <li>New instructor: <strong t-out="object.calendar_event_id.user_id.name or 'TBA'"/></li>
    </ul>
    <p>Everything else remains the same. See you in class!</p>
    <p>The CoreLab team</p>
  </t>
  <t t-elif="object.student_id.lang == 'ca_ES'">
    <p>Hola <t t-out="object.student_id.name or ''"/>,</p>
    <p>Et volem informar que l'instructor/a de la teva classe propera ha canviat:</p>
    <ul>
      <li>Classe: <strong t-out="object.calendar_event_id.name or ''"/></li>
      <li>Nou/nova instructor/a: <strong t-out="object.calendar_event_id.user_id.name or 'Per confirmar'"/></li>
    </ul>
    <p>La resta es mant&#233; igual. Ens veiem a classe!</p>
    <p>L&#39;equip de CoreLab</p>
  </t>
  <t t-else="">
    <p>Hola <t t-out="object.student_id.name or ''"/>,</p>
    <p>Te queremos informar que el/la instructor/a de tu pr&#243;xima clase ha cambiado:</p>
    <ul>
      <li>Clase: <strong t-out="object.calendar_event_id.name or ''"/></li>
      <li>Nuevo/a instructor/a: <strong t-out="object.calendar_event_id.user_id.name or 'Por confirmar'"/></li>
    </ul>
    <p>Todo lo dem&#225;s sigue igual. &#161;Nos vemos en clase!</p>
    <p>El equipo de CoreLab</p>
  </t>
  <t t-set="notice_lang" t-value="object.student_id.lang"/>
  <t t-call="fitness_notifications.mail_footer_no_reply"/>
</div>
            </field>
        </record>

        <!-- A whole class moving to a new time. Sent alongside the bell that
             already fired, because the bell alone never reaches a student who
             does not open the app before the old start time - which is the
             one student this email exists for. Cancellation has always sent
             both; a reschedule is no less urgent. -->
        <record id="mail_template_class_rescheduled" model="mail.template">
            <field name="lang">{{ object.student_id.lang }}</field>
            <field name="name">Fitness: Class Rescheduled</field>
            <field name="model_id" ref="fitness_bookings.model_fitness_booking"/>
            <field name="subject">{{ 'Your class has been moved' if object.student_id.lang == 'en_US' else ("La teva classe s'ha mogut" if object.student_id.lang == 'ca_ES' else 'Tu clase ha cambiado de horario') }}</field>
            <field name="partner_to">{{ object.student_id.id }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="email_from">{{ user.company_id.email_formatted or '"CoreLab Studio" &lt;info@corelabstudio.es&gt;' }}</field>
            <field name="reply_to">{{ user.company_id.email_formatted or '"CoreLab Studio" &lt;info@corelabstudio.es&gt;' }}</field>
            <field name="body_html" type="html">
<div style="margin:0;padding:0;font-size:14px;line-height:1.6;color-scheme:light only;supported-color-schemes:light only;background-color:#FAF9F6;color:#2E2724;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;padding:20px 22px;border-radius:10px;">
  <t t-set="when" t-value="format_datetime(object.calendar_event_id.start, tz='Europe/Madrid', dt_format='EEEE d MMMM, HH:mm', lang_code=object.student_id.lang or 'es_ES')"/>
  <t t-if="object.student_id.lang == 'en_US'">
    <p>Hi <t t-out="object.student_id.name or ''"/>,</p>
    <p>The studio has moved one of your classes to a new time:</p>
    <ul>
      <li>Class: <strong t-out="object.calendar_event_id.name or ''"/></li>
      <li>New time: <strong t-out="when"/></li>
    </ul>
    <p>Your place is still booked and your credit is unchanged. If the new time does not suit you, message us in the app or on WhatsApp and we will sort it out.</p>
    <p>The CoreLab team</p>
  </t>
  <t t-elif="object.student_id.lang == 'ca_ES'">
    <p>Hola <t t-out="object.student_id.name or ''"/>,</p>
    <p>L&#39;estudi ha mogut una de les teves classes a un nou horari:</p>
    <ul>
      <li>Classe: <strong t-out="object.calendar_event_id.name or ''"/></li>
      <li>Nou horari: <strong t-out="when"/></li>
    </ul>
    <p>La teva pla&#231;a segueix reservada i el teu cr&#232;dit no canvia. Si el nou horari no et va b&#233;, escriu-nos per l'app o per WhatsApp i ho arreglem.</p>
    <p>L&#39;equip de CoreLab</p>
  </t>
  <t t-else="">
    <p>Hola <t t-out="object.student_id.name or ''"/>,</p>
    <p>El estudio ha cambiado el horario de una de tus clases:</p>
    <ul>
      <li>Clase: <strong t-out="object.calendar_event_id.name or ''"/></li>
      <li>Nuevo horario: <strong t-out="when"/></li>
    </ul>
    <p>Tu plaza sigue reservada y tu cr&#233;dito no cambia. Si el nuevo horario no te va bien, escríbenos por la app o por WhatsApp y lo solucionamos.</p>
    <p>El equipo de CoreLab</p>
  </t>
  <t t-set="notice_lang" t-value="object.student_id.lang"/>
  <t t-call="fitness_notifications.mail_footer_no_reply"/>
</div>
            </field>
        </record>

    </data>
</odoo>
