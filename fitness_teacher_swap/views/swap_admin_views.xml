<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── List view: full swap history ──────────────────────────────────────── -->

    <record id="view_fitness_teacher_swap_list" model="ir.ui.view">
        <field name="name">fitness.teacher.swap.list</field>
        <field name="model">fitness.teacher.swap</field>
        <field name="arch" type="xml">
            <list string="Instructor Swaps" default_order="create_date desc"
                  decoration-info="initiated_by == 'teacher'"
                  create="0" delete="0" edit="0">
                <field name="create_date" string="When"/>
                <field name="class_name" string="Class"/>
                <field name="class_start" string="Class Date / Time"/>
                <field name="class_type_id" string="Type" optional="show"/>
                <field name="original_teacher_id" string="From"/>
                <field name="new_teacher_id" string="To"/>
                <field name="initiated_by" widget="badge"
                       decoration-info="initiated_by == 'teacher'"
                       decoration-warning="initiated_by == 'admin'"
                       string="Source"/>
                <field name="reason" string="Reason" optional="show"/>
            </list>
        </field>
    </record>

    <!-- ── Form view: full swap detail ───────────────────────────────────────── -->

    <record id="view_fitness_teacher_swap_form" model="ir.ui.view">
        <field name="name">fitness.teacher.swap.form</field>
        <field name="model">fitness.teacher.swap</field>
        <field name="arch" type="xml">
            <form string="Instructor Swap" create="0" edit="0">
                <sheet>
                    <group string="Class">
                        <field name="class_name" readonly="1"/>
                        <field name="class_type_id" readonly="1"/>
                        <field name="class_start" readonly="1"/>
                        <field name="calendar_event_id" readonly="1"/>
                    </group>
                    <group string="Instructors">
                        <field name="original_teacher_id" readonly="1"/>
                        <field name="new_teacher_id" readonly="1"/>
                    </group>
                    <group string="Details">
                        <field name="initiated_by" readonly="1"/>
                        <field name="create_date" readonly="1" string="Recorded At"/>
                        <field name="create_uid" readonly="1" string="Recorded By"/>
                    </group>
                    <group string="Reason" invisible="not reason">
                        <field name="reason" nolabel="1" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Search view ────────────────────────────────────────────────────────── -->

    <record id="view_fitness_teacher_swap_search" model="ir.ui.view">
        <field name="name">fitness.teacher.swap.search</field>
        <field name="model">fitness.teacher.swap</field>
        <field name="arch" type="xml">
            <search>
                <field name="class_name" string="Class"/>
                <field name="original_teacher_id" string="From Instructor"/>
                <field name="new_teacher_id" string="To Instructor"/>
                <separator/>
                <filter string="Instructor Portal" name="filter_teacher"
                        domain="[('initiated_by', '=', 'teacher')]"/>
                <filter string="Admin Backend" name="filter_admin"
                        domain="[('initiated_by', '=', 'admin')]"/>
                <filter string="Has Reason" name="filter_reason"
                        domain="[('reason', '!=', False)]"/>
                <group>
                    <filter string="From Instructor" name="group_from"
                            context="{'group_by': 'original_teacher_id'}"/>
                    <filter string="To Instructor" name="group_to"
                            context="{'group_by': 'new_teacher_id'}"/>
                    <filter string="Class" name="group_class"
                            context="{'group_by': 'class_name'}"/>
                    <filter string="Month" name="group_month"
                            context="{'group_by': 'class_start:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ── Action + menu ─────────────────────────────────────────────────────── -->

    <record id="action_fitness_teacher_swaps" model="ir.actions.act_window">
        <field name="name">Instructor Swaps</field>
        <field name="res_model">fitness.teacher.swap</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No instructor swap records yet</p>
            <p>Every instructor reassignment — from the admin backend or the instructor portal — is logged here automatically.</p>
        </field>
    </record>

    <menuitem
        id="menu_fitness_teacher_swaps"
        name="Instructor Swaps"
        parent="fitness_core.menu_fitness_teachers_root"
        action="fitness_teacher_swap.action_fitness_teacher_swaps"
        sequence="30"
        groups="fitness_core.group_fitness_manager"
    />

</odoo>
