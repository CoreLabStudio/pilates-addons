<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1": seed once, never overwrite. Same reasoning as
         demo_classrooms.xml, and the same exposure - name and description are
         translate=True, and capacity_max on the group type is the same 14 the
         studio moved to 7 on the classroom. Anything edited in the back office
         here was being rewritten on every upgrade of this module. The file has
         changed once since it was written, so freezing it costs nothing. -->
    <data noupdate="1">

        <record id="session_type_group" model="fitness.session.type">
            <field name="name">Group Class</field>
            <field name="code">GROUP</field>
            <field name="capacity_min">1</field>
            <field name="capacity_max">14</field>
            <field name="sequence">10</field>
            <field name="description">Group fitness class open to multiple participants up to classroom capacity.</field>
        </record>

        <record id="session_type_private" model="fitness.session.type">
            <field name="name">Private Session</field>
            <field name="code">PRIVATE</field>
            <field name="capacity_min">1</field>
            <field name="capacity_max">1</field>
            <field name="sequence">20</field>
            <field name="description">One-on-one private training session with instructor.</field>
        </record>

        <record id="session_type_duo" model="fitness.session.type">
            <field name="name">Duo Session</field>
            <field name="code">DUO</field>
            <field name="capacity_min">2</field>
            <field name="capacity_max">2</field>
            <field name="sequence">30</field>
            <field name="description">Two-person session sharing one instructor. Each pays the duo rate.</field>
        </record>

    </data>
</odoo>
