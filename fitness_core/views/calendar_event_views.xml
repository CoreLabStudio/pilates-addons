<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend calendar.event form to add Fitness Class tab -->
    <record id="view_calendar_event_form_fitness" model="ir.ui.view">
        <field name="name">calendar.event.form.fitness</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="fitness_note" placeholder="Optional note for this specific class…"
                       widget="text" invisible="not is_fitness_class"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Fitness Class" name="fitness_class_page">
                    <group invisible="not is_fitness_class">
                        <field name="image_1920" widget="image"
                               options="{'preview_image': 'image_512'}"
                               class="oe_avatar"
                               string="Class Photo (overrides type default)"
                               colspan="2"/>
                    </group>
                    <group>
                        <group string="Class Setup">
                            <field name="is_fitness_class"/>
                            <field name="class_type_id"
                                   invisible="not is_fitness_class"/>
                            <field name="classroom_id"
                                   invisible="not is_fitness_class"/>
                            <field name="session_type"
                                   invisible="not is_fitness_class"/>
                            <field name="class_state" widget="badge"
                                   decoration-success="class_state == 'scheduled'"
                                   decoration-muted="class_state == 'cancelled'"
                                   invisible="not is_fitness_class"/>
                        </group>
                        <group string="Capacity" invisible="not is_fitness_class">
                            <field name="capacity"/>
                            <field name="booked_seats"/>
                            <field name="available_seats"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extend calendar list view to show classroom for fitness classes -->
    <record id="view_calendar_event_list_fitness" model="ir.ui.view">
        <field name="name">calendar.event.list.fitness</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="classroom_id" optional="show"/>
                <field name="class_type_id" optional="show"/>
                <field name="available_seats" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Standalone list for the Schedule menu (fitness classes only) -->
    <record id="view_fitness_schedule_list" model="ir.ui.view">
        <field name="name">calendar.event.fitness.schedule.list</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <list default_order="start asc"
                  decoration-warning="available_seats == 0 and class_state == 'scheduled'">
                <field name="name" string="Class"/>
                <field name="start" string="Date / Time"/>
                <field name="class_state" widget="badge"
                       decoration-success="class_state == 'scheduled'"
                       string="Status"/>
                <field name="stop" string="End" optional="hide"/>
                <field name="classroom_id" string="Studio"/>
                <field name="class_type_id" string="Class Type"/>
                <field name="session_type" string="Session"/>
                <field name="capacity" string="Capacity"/>
                <field name="booked_seats" string="Booked"/>
                <field name="available_seats" string="Available"/>
            </list>
        </field>
    </record>

    <!-- Relabel "Meeting Subject" → "Class Name" in the form header -->
    <record id="view_calendar_event_form_fitness_name" model="ir.ui.view">
        <field name="name">calendar.event.form.fitness.name</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='name']" position="attributes">
                <attribute name="string">Class Name</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="placeholder">e.g. Barre Beginner</attribute>
            </xpath>
        </field>
    </record>

    <!-- Action: Schedule (fitness classes only) -->
    <!-- The Schedule used to fall back to Odoo's stock calendar.event calendar,
         which carries js_class="attendee_calendar": the personal-meetings view.
         It shows only events the logged-in user is an *attendee* of, and its
         sidebar filters by attendee through calendar.contacts. A fitness class
         has an instructor in user_id and no attendees at all, so the calendar
         came up empty while the list beside it showed hundreds of classes -
         and ticking a second instructor narrowed the attendee filter instead
         of widening it, which is why picking more of them showed fewer
         classes. This view drops that js_class and filters on the instructor
         the studio actually sets. -->
    <record id="view_fitness_schedule_calendar" model="ir.ui.view">
        <field name="name">calendar.event.fitness.schedule.calendar</field>
        <field name="model">calendar.event</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <calendar string="Class Schedule"
                      date_start="start" date_stop="stop"
                      color="user_id" mode="week"
                      quick_create="0" event_open_popup="true">
                <field name="name"/>
                <!-- filter="1" puts instructors in the sidebar. Several ticked
                     there OR together, which is the behaviour the studio
                     expected and did not get. -->
                <field name="user_id" filters="1" avatar_field="avatar_128"/>
                <field name="classroom_id" filters="1"/>
                <field name="class_type_id"/>
                <field name="capacity"/>
                <field name="booked_seats"/>
                <field name="class_state" invisible="1"/>
            </calendar>
        </field>
    </record>

    <record id="action_fitness_schedule" model="ir.actions.act_window">
        <field name="name">Schedule</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="domain">[('is_fitness_class', '=', True)]</field>
        <field name="context">{'default_is_fitness_class': True}</field>
        <!-- Pin each mode to the studio's own view. Without this the calendar
             mode resolves to whichever calendar.event calendar has the highest
             priority, which is Odoo's attendee one. -->
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'sequence': 10, 'view_mode': 'list',
                    'view_id': ref('view_fitness_schedule_list')}),
            (0, 0, {'sequence': 20, 'view_mode': 'calendar',
                    'view_id': ref('view_fitness_schedule_calendar')}),
            (0, 0, {'sequence': 30, 'view_mode': 'form'})]"/>
    </record>

</odoo>
