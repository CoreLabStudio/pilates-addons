<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Extend calendar.event form to add Fitness Class tab -->
    <record id="view_calendar_event_form_fitness" model="ir.ui.view">
        <field name="name">calendar.event.form.fitness</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="fitness_note" placeholder="Optional note for this specific class…"
                       widget="text" invisible="not is_fitness_class"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Fitness Class" name="fitness_class_page">
                    <group invisible="not is_fitness_class">
                        <field name="image_1920" widget="image"
                               options="{'preview_image': 'image_512'}"
                               class="oe_avatar"
                               string="Class Photo (overrides type default)"
                               colspan="2"/>
                    </group>
                    <group>
                        <group string="Class Setup">
                            <field name="is_fitness_class"/>
                            <field name="class_type_id"
                                   invisible="not is_fitness_class"/>
                            <field name="classroom_id"
                                   invisible="not is_fitness_class"/>
                            <field name="session_type"
                                   invisible="not is_fitness_class"/>
                            <field name="class_state" widget="badge"
                                   decoration-success="class_state == 'scheduled'"
                                   decoration-muted="class_state == 'cancelled'"
                                   invisible="not is_fitness_class"/>
                        </group>
                        <group string="Capacity" invisible="not is_fitness_class">
                            <field name="capacity"/>
                            <field name="booked_seats"/>
                            <field name="available_seats"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Extend calendar list view to show classroom for fitness classes -->
    <record id="view_calendar_event_list_fitness" model="ir.ui.view">
        <field name="name">calendar.event.list.fitness</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="classroom_id" optional="show"/>
                <field name="class_type_id" optional="show"/>
                <field name="available_seats" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Standalone list for the Schedule menu (fitness classes only) -->
    <record id="view_fitness_schedule_list" model="ir.ui.view">
        <field name="name">calendar.event.fitness.schedule.list</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <list default_order="start asc"
                  decoration-warning="available_seats == 0 and class_state == 'scheduled'">
                <field name="name" string="Class"/>
                <field name="start" string="Date / Time"/>
                <field name="class_state" widget="badge"
                       decoration-success="class_state == 'scheduled'"
                       string="Status"/>
                <field name="stop" string="End" optional="hide"/>
                <field name="classroom_id" string="Studio"/>
                <field name="class_type_id" string="Class Type"/>
                <field name="session_type" string="Session"/>
                <!-- Summed, so filtering to a day answers "how many
                     students are coming" without anyone adding up a column
                     by hand. Odoo totals these in the footer and per group. -->
                <field name="capacity" string="Capacity" sum="Places"/>
                <field name="booked_seats" string="Booked" sum="Students"/>
                <field name="available_seats" string="Available" sum="Free"/>
            </list>
        </field>
    </record>

    <!-- Relabel "Meeting Subject" → "Class Name" in the form header -->
    <record id="view_calendar_event_form_fitness_name" model="ir.ui.view">
        <field name="name">calendar.event.form.fitness.name</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='name']" position="attributes">
                <attribute name="string">Class Name</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="placeholder">e.g. Barre Beginner</attribute>
            </xpath>
        </field>
    </record>

    <!-- Action: Schedule (fitness classes only) -->
    <!-- The Schedule used to fall back to Odoo's stock calendar.event calendar,
         which carries js_class="attendee_calendar": the personal-meetings view.
         It shows only events the logged-in user is an *attendee* of, and its
         sidebar filters by attendee through calendar.contacts. A fitness class
         has an instructor in user_id and no attendees at all, so the calendar
         came up empty while the list beside it showed hundreds of classes -
         and ticking a second instructor narrowed the attendee filter instead
         of widening it, which is why picking more of them showed fewer
         classes. This view drops that js_class and filters on the instructor
         the studio actually sets. -->
    <record id="view_fitness_schedule_calendar" model="ir.ui.view">
        <field name="name">calendar.event.fitness.schedule.calendar</field>
        <field name="model">calendar.event</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <calendar string="Class Schedule"
                      date_start="start" date_stop="stop"
                      color="user_id" mode="week"
                      quick_create="0" event_open_popup="true">
                <field name="name"/>
                <!-- filter="1" puts instructors in the sidebar. Several ticked
                     there OR together, which is the behaviour the studio
                     expected and did not get. -->
                <field name="user_id" filters="1" avatar_field="avatar_128"/>
                <field name="classroom_id" filters="1"/>
                <field name="class_type_id"/>
                <field name="capacity"/>
                <field name="booked_seats"/>
                <field name="class_state" invisible="1"/>
            </calendar>
        </field>
    </record>

    <!-- ── The Schedule's own search panel ──────────────────────────────
         Pinned on the action below. Without it the page fell through to
         Odoo's stock calendar.event search, which is built for personal
         meetings: a relative date filter and nothing about rooms, classes or
         how full anything is. -->
    <record id="view_fitness_schedule_search" model="ir.ui.view">
        <field name="name">calendar.event.fitness.schedule.search</field>
        <field name="model">calendar.event</field>
        <field name="arch" type="xml">
            <search string="Classes">
                <field name="name" string="Class"/>
                <!-- Searchable, so the panel offers a real date box. This is
                     what was missing: the stock filter only moved in whole
                     months relative to today. -->
                <field name="start" string="Date"/>
                <field name="class_type_id"/>
                <field name="classroom_id" string="Studio"/>
                <field name="user_id" string="Instructor"/>

                <separator/>
                <!-- Ranges people actually ask for. None of them stop at the
                     end of a month, and "Upcoming" is the one the desk wants
                     nine times out of ten. -->
                <filter string="Today" name="today"
                        domain="[('start', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                 ('start', '&lt;', datetime.datetime.combine(context_today() + relativedelta(days=1), datetime.time(0,0,0)))]"/>
                <filter string="Tomorrow" name="tomorrow"
                        domain="[('start', '&gt;=', datetime.datetime.combine(context_today() + relativedelta(days=1), datetime.time(0,0,0))),
                                 ('start', '&lt;', datetime.datetime.combine(context_today() + relativedelta(days=2), datetime.time(0,0,0)))]"/>
                <filter string="Next 7 days" name="next_7"
                        domain="[('start', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                 ('start', '&lt;', datetime.datetime.combine(context_today() + relativedelta(days=7), datetime.time(0,0,0)))]"/>
                <filter string="Next 30 days" name="next_30"
                        domain="[('start', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0))),
                                 ('start', '&lt;', datetime.datetime.combine(context_today() + relativedelta(days=30), datetime.time(0,0,0)))]"/>
                <filter string="Upcoming" name="upcoming"
                        domain="[('start', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <filter string="Past" name="past"
                        domain="[('start', '&lt;', datetime.datetime.combine(context_today(), datetime.time(0,0,0)))]"/>
                <!-- And the open-ended one, so a date typed into the box above
                     can be narrowed by month without the filter fighting it. -->
                <filter string="Date" name="by_date" date="start"/>

                <separator/>
                <filter string="Scheduled" name="scheduled"
                        domain="[('class_state', '=', 'scheduled')]"/>
                <filter string="Cancelled" name="cancelled"
                        domain="[('class_state', '=', 'cancelled')]"/>
                <!-- Archived is a different thing from cancelled: it hides a
                     row without telling anybody, and is what closing a
                     recurring slot does to the classes it had generated.
                     Stock calendar.event offered this filter and giving the
                     Schedule its own search view dropped it, which left no
                     way to find an archived class at all. -->
                <filter string="Archived" name="inactive"
                        domain="[('active', '=', False)]"/>

                <separator/>
                <!-- How full. "Nobody booked" is the one that matters most:
                     it is the list the studio scans before deciding what to
                     cancel. -->
                <filter string="Nobody booked" name="empty"
                        domain="[('booked_seats', '=', 0)]"/>
                <filter string="Has students" name="has_students"
                        domain="[('booked_seats', '&gt;', 0)]"/>
                <filter string="Has space" name="has_space"
                        domain="[('available_seats', '&gt;', 0)]"/>
                <filter string="Full" name="full"
                        domain="[('available_seats', '&lt;=', 0), ('capacity', '&gt;', 0)]"/>

                <!-- Odoo 19 rejects expand= on a search group, and a
                     group-by filter wants an explicit empty domain - the same
                     shape the stock calendar.event search uses. -->
                <group>
                    <filter string="Day" name="group_day" domain="[]"
                            context="{'group_by': 'start:day'}"/>
                    <filter string="Week" name="group_week" domain="[]"
                            context="{'group_by': 'start:week'}"/>
                    <filter string="Month" name="group_month" domain="[]"
                            context="{'group_by': 'start:month'}"/>
                    <separator/>
                    <filter string="Class Type" name="group_class_type" domain="[]"
                            context="{'group_by': 'class_type_id'}"/>
                    <filter string="Studio" name="group_classroom" domain="[]"
                            context="{'group_by': 'classroom_id'}"/>
                    <filter string="Instructor" name="group_teacher" domain="[]"
                            context="{'group_by': 'user_id'}"/>
                    <filter string="Status" name="group_state" domain="[]"
                            context="{'group_by': 'class_state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_fitness_schedule" model="ir.actions.act_window">
        <field name="name">Schedule</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="domain">[('is_fitness_class', '=', True)]</field>
        <!-- Opens on what is still to come. The page is used to run the week
             ahead, and a list that opens on every class since the studio
             opened buries that. Past is one click away. -->
        <field name="context">{'default_is_fitness_class': True,
                               'search_default_upcoming': 1}</field>
        <!-- Pinned, like the list and calendar views below. Unpinned it fell
             through to Odoo's personal-meetings search. -->
        <field name="search_view_id" ref="view_fitness_schedule_search"/>
        <!-- Pin each mode to the studio's own view. Without this the calendar
             mode resolves to whichever calendar.event calendar has the highest
             priority, which is Odoo's attendee one. -->
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'sequence': 10, 'view_mode': 'list',
                    'view_id': ref('view_fitness_schedule_list')}),
            (0, 0, {'sequence': 20, 'view_mode': 'calendar',
                    'view_id': ref('view_fitness_schedule_calendar')}),
            (0, 0, {'sequence': 30, 'view_mode': 'form'})]"/>
    </record>

</odoo>
