<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fitness_class_category_list" model="ir.ui.view">
        <field name="name">fitness.class.category.list</field>
        <field name="model">fitness.class.category</field>
        <field name="arch" type="xml">
            <list string="Class Categories">
                <field name="image_512" widget="image" options="{'size': [38, 38]}" string=""/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_class_category_form" model="ir.ui.view">
        <field name="name">fitness.class.category.form</field>
        <field name="model">fitness.class.category</field>
        <field name="arch" type="xml">
            <form string="Class Category">
                <sheet>
                    <div class="oe_title">
                        <field name="image_1920" widget="image" class="oe_avatar"
                               options="{'preview_image': 'image_512'}"/>
                        <h1>
                            <field name="name" placeholder="e.g. Barre"/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitness_class_category" model="ir.actions.act_window">
        <field name="name">Class Categories</field>
        <field name="res_model">fitness.class.category</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
