<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Weekly teaching load. One row per instructor, hours summed from the
         recurring schedule rather than entered anywhere. Opening a row drops
         into that instructor's slots so the total can be checked against the
         classes it came from. -->
    <record id="view_fitness_teacher_hours_list" model="ir.ui.view">
        <field name="name">fitness.teacher.hours.list</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list string="Weekly Teaching Hours" create="false" delete="false">
                <field name="name" string="Instructor"/>
                <field name="login" string="Login"/>
                <field name="fitness_weekly_class_count" string="Classes / week"/>
                <field name="fitness_weekly_hours" string="Hours / week" sum="Total hours"/>
                <field name="fitness_weekly_days" string="Days"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_teacher_hours_form" model="ir.ui.view">
        <field name="name">fitness.teacher.hours.form</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <form string="Weekly Teaching Hours" create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="login" readonly="1"/>
                        </group>
                        <group>
                            <field name="fitness_weekly_class_count" readonly="1"/>
                            <field name="fitness_weekly_hours" readonly="1"/>
                            <field name="fitness_weekly_days" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Recurring Classes">
                            <!-- the slots the total is made of -->
                            <field name="fitness_schedule_ids" readonly="1"
                                   domain="[('active', '=', True)]">
                                <list>
                                    <field name="weekday"/>
                                    <field name="start_time" widget="float_time"/>
                                    <field name="duration" sum="Hours"/>
                                    <field name="class_type_id"/>
                                    <field name="classroom_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Instructors only: every portal student is a res.users too, and a list
         of six hundred students with 0 hours is not the report. -->
    <record id="action_fitness_teacher_hours" model="ir.actions.act_window">
        <field name="name">Weekly Hours</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <!-- Pinned. Without this Odoo picks the default res.users list, and on
             a fresh database - which is what odoo.sh builds - base's own view
             can win on id, so the report renders as a plain user list with
             none of the hours on it. -->
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_fitness_teacher_hours_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_fitness_teacher_hours_form')})]"/>
        <!-- Archived instructors are archived on purpose; the client was
             listing one because nothing here said otherwise. -->
        <field name="context">{'active_test': True}</field>
        <!-- A literal the browser can evaluate. The group lookup happens in
             _search_fitness_is_teacher on the server: an action's domain is a
             string evaluated client-side, where ref() does not exist, and
             %(xmlid)d is not substituted in a plain char field. -->
        <field name="domain">[('fitness_is_teacher', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No instructors yet</p>
            <p>Hours here are added up from the recurring schedule. Assign an
               instructor to a class in Classes &gt; Schedule and the total
               appears on its own.</p>
        </field>
    </record>

    <menuitem
        id="menu_fitness_teacher_hours"
        name="Weekly Hours"
        parent="menu_fitness_teachers_root"
        action="fitness_core.action_fitness_teacher_hours"
        sequence="15"
    />

</odoo>
