<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fitness_session_type_list" model="ir.ui.view">
        <field name="name">fitness.session.type.list</field>
        <field name="model">fitness.session.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" widget="badge"/>
                <field name="capacity_min" string="Min Pax"/>
                <field name="capacity_max" string="Max Pax"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_session_type_form" model="ir.ui.view">
        <field name="name">fitness.session.type.form</field>
        <field name="model">fitness.session.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" text="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Group Class"/></h1>
                    </div>
                    <group>
                        <group string="Details">
                            <field name="code"/>
                            <field name="capacity_min"/>
                            <field name="capacity_max"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Describe this session type..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitness_session_type" model="ir.actions.act_window">
        <field name="name">Session Types</field>
        <field name="res_model">fitness.session.type</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

</odoo>
