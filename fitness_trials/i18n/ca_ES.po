msgstr "%(name)s està inscrit a %(cls)s."

#. module: fitness_trials
#. odoo-python
#: code:addons/fitness_trials/models/trial_request.py:0
msgid "Booked"
msgstr "Reservada"

#. module: fitness_trials
#. odoo-python
#: code:addons/fitness_trials/models/trial_request.py:0
msgid "Choose a class slot first. Approval books the student into that class, so there has to be one."
msgstr "Tria primer una classe. En aprovar s'inscriu l'alumne a aquesta classe, així que n'hi ha d'haver una."

#. module: fitness_trials
#. odoo-python
#: code:addons/fitness_trials/models/trial_request.py:0
msgid "No student record matches this request. It was submitted from the public site by %(email)s, and nobody with that address has an account yet."
msgstr "Cap alumne coincideix amb aquesta sol·licitud. Es va enviar des del web públic amb %(email)s, i encara no hi ha cap compte amb aquesta adreça."

