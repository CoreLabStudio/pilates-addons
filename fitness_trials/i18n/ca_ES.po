#. odoo-python
#: code:addons/fitness_trials/models/trial_request.py:0
msgid "%(cls)s on %(when)s."
msgstr "%(cls)s el %(when)s."

#. module: fitness_trials
#. odoo-python
#: code:addons/fitness_trials/models/trial_request.py:0
msgid "%(name)s has already used their free trial, and has no credit left to book with. Sell them a class instead, or book it from the back office."
msgstr "%(name)s ja ha fet servir la seva classe de prova gratuïta i no li queda crèdit per reservar. Ven-li una classe o reserva-la des de l'administració."

#. module: fitness_trials
#. odoo-python
#: code:addons/fitness_trials/models/trial_request.py:0
