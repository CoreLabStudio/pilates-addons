msgstr "Indica si prefieres la mañana o la tarde."

#. module: fitness_trials
#. odoo-python
#: code:addons/fitness_trials/controllers/trial.py:0
msgid "Please tell us whether you have used a Reformer before."
msgstr "Dinos si has usado un Reformer antes."

#. module: fitness_trials
#. odoo-python
#: code:addons/fitness_trials/models/trial_request.py:0
