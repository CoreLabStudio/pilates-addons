msgstr "Tu clase de prueba: %(cls)s."

#. module: fitness_trials
#. odoo-python
#: code:addons/fitness_trials/models/trial_request.py:0
msgid "the class"
msgstr "la clase"

#. module: fitness_trials
#. odoo-python
#: code:addons/fitness_trials/controllers/trial.py:0
