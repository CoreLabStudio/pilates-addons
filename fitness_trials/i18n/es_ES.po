msgstr "Horarios para %(who)s"

#. module: fitness_trials
#. odoo-python
#: code:addons/fitness_trials/models/trial_request.py:0
msgid "this request"
msgstr "esta solicitud"

#. module: fitness_trials
#. odoo-python
#: code:addons/fitness_trials/models/trial_request.py:0
