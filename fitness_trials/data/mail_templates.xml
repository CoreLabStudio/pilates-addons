<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

  <!-- ── Pending (sent on creation) ──────────────────────────────────────── -->
  <record id="mail_template_trial_pending" model="mail.template">
    <field name="name">Trial Request: Received (EN/ES/CA)</field>
    <field name="model_id" ref="fitness_trials.model_fitness_trial_request"/>
    <field name="subject">{{ 'Trial class request received · CoreLab' if object.lang == 'en_US' else ('Sol·licitud de classe de prova rebuda · CoreLab' if object.lang == 'ca_ES' else 'Solicitud de clase de prueba recibida · CoreLab') }}</field>
    <!-- Odoo defaults use_default_to to True, which ignores email_to and
         asks the record for its recipients instead. A trial submitted from
         the public form has no partner, so that returned nobody: the mail
         was created with no recipient, marked sent, and delivered to no
         one. The address typed on the form is the only one there is. -->
    <field name="use_default_to" eval="False"/>
    <field name="email_to">{{ object.email }}</field>
    <field name="auto_delete" eval="False"/>
    <field name="email_from">{{ user.company_id.email_formatted or '"CoreLab Studio" &lt;info@corelabstudio.es&gt;' }}</field>
    <field name="reply_to">{{ user.company_id.email_formatted or '"CoreLab Studio" &lt;info@corelabstudio.es&gt;' }}</field>
    <field name="body_html" type="html">
<div style="font-family:Georgia,'Times New Roman',serif;max-width:560px;margin:0 auto;padding:40px 24px;color:#2c2c2c;background-color:#faf9f7;color-scheme:light only;supported-color-schemes:light only;">

  <t t-if="object.lang == 'ca_ES'">
    <p style="margin:0 0 28px;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#9e8e7e;">CoreLab Studio · Matadepera, Barcelona</p>
    <h1 style="margin:0 0 20px;font-size:32px;font-weight:400;line-height:1.2;letter-spacing:-0.02em;">Hola, <t t-out="object.name"/>.</h1>
    <div style="margin:0 0 20px;padding:16px 20px;background:#f0ece6;border-radius:10px;font-size:14px;letter-spacing:0.08em;text-transform:uppercase;color:#9e8e7e;">
      <t t-if="object.class_interest == 'reformer'">Reformer Pilates</t>
      <t t-else="">Barre</t>
    </div>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Hem rebut la teva sol·licitud de classe de prova. Ens posarem en contacte amb tu aviat per confirmar el dia i l'hora.</p>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Si tens cap pregunta, escriu-nos per l'app o per WhatsApp — tens les dades al final d'aquest correu.</p>
    <p style="margin:32px 0 0;font-size:14px;line-height:1.6;color:#9e8e7e;border-top:1px solid #e8e0d6;padding-top:24px;">CoreLab Studio · Matadepera, Barcelona<br/>Fins aviat.</p>
  </t>

  <t t-elif="object.lang == 'es_ES'">
    <p style="margin:0 0 28px;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#9e8e7e;">CoreLab Studio · Matadepera, Barcelona</p>
    <h1 style="margin:0 0 20px;font-size:32px;font-weight:400;line-height:1.2;letter-spacing:-0.02em;">Hola, <t t-out="object.name"/>.</h1>
    <div style="margin:0 0 20px;padding:16px 20px;background:#f0ece6;border-radius:10px;font-size:14px;letter-spacing:0.08em;text-transform:uppercase;color:#9e8e7e;">
      <t t-if="object.class_interest == 'reformer'">Reformer Pilates</t>
      <t t-else="">Barre</t>
    </div>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Hemos recibido tu solicitud de clase de prueba. Nos pondremos en contacto contigo pronto para confirmar el día y la hora.</p>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Si tienes alguna pregunta, escríbenos por la app o por WhatsApp — tienes los datos al final de este correo.</p>
    <p style="margin:32px 0 0;font-size:14px;line-height:1.6;color:#9e8e7e;border-top:1px solid #e8e0d6;padding-top:24px;">CoreLab Studio · Matadepera, Barcelona<br/>Hasta pronto.</p>
  </t>

  <t t-else="">
    <p style="margin:0 0 28px;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#9e8e7e;">CoreLab Studio · Matadepera, Barcelona</p>
    <h1 style="margin:0 0 20px;font-size:32px;font-weight:400;line-height:1.2;letter-spacing:-0.02em;">Hello, <t t-out="object.name"/>.</h1>
    <div style="margin:0 0 20px;padding:16px 20px;background:#f0ece6;border-radius:10px;font-size:14px;letter-spacing:0.08em;text-transform:uppercase;color:#9e8e7e;">
      <t t-if="object.class_interest == 'reformer'">Reformer Pilates</t>
      <t t-else="">Barre</t>
    </div>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Your trial class request has been received. We'll be in touch shortly to confirm a date and time that works for you.</p>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">If you have any questions in the meantime, message us in the app or on WhatsApp — the details are at the bottom of this email.</p>
    <p style="margin:32px 0 0;font-size:14px;line-height:1.6;color:#9e8e7e;border-top:1px solid #e8e0d6;padding-top:24px;">CoreLab Studio · Matadepera, Barcelona<br/>See you on the mat.</p>
  </t>

  <t t-set="notice_lang" t-value="object.lang"/>
  <t t-call="fitness_notifications.mail_footer_no_reply"/>
</div>
    </field>
  </record>

  <!-- ── Scheduled (sent when status→scheduled + datetime set) ───────────── -->
  <record id="mail_template_trial_scheduled" model="mail.template">
    <field name="name">Trial Request: Scheduled Confirmation (EN/ES/CA)</field>
    <field name="model_id" ref="fitness_trials.model_fitness_trial_request"/>
    <field name="subject">{{ 'Your CoreLab trial class is confirmed' if object.lang == 'en_US' else ('La teva classe de prova a CoreLab és confirmada' if object.lang == 'ca_ES' else 'Tu clase de prueba en CoreLab está confirmada') }}</field>
    <!-- Odoo defaults use_default_to to True, which ignores email_to and
         asks the record for its recipients instead. A trial submitted from
         the public form has no partner, so that returned nobody: the mail
         was created with no recipient, marked sent, and delivered to no
         one. The address typed on the form is the only one there is. -->
    <field name="use_default_to" eval="False"/>
    <field name="email_to">{{ object.email }}</field>
    <field name="auto_delete" eval="False"/>
    <field name="email_from">{{ user.company_id.email_formatted or '"CoreLab Studio" &lt;info@corelabstudio.es&gt;' }}</field>
    <field name="reply_to">{{ user.company_id.email_formatted or '"CoreLab Studio" &lt;info@corelabstudio.es&gt;' }}</field>
    <field name="body_html" type="html">
<div style="font-family:Georgia,'Times New Roman',serif;max-width:560px;margin:0 auto;padding:40px 24px;color:#2c2c2c;background-color:#faf9f7;color-scheme:light only;supported-color-schemes:light only;">

  <t t-if="object.lang == 'ca_ES'">
    <p style="margin:0 0 28px;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#9e8e7e;">CoreLab Studio · Matadepera, Barcelona</p>
    <h1 style="margin:0 0 20px;font-size:32px;font-weight:400;line-height:1.2;letter-spacing:-0.02em;">Confirmat.</h1>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Hola <t t-out="object.name"/>, la teva classe de prova ha quedat confirmada:</p>
    <div style="margin:24px 0;padding:20px 24px;background:#f0ece6;border-radius:12px;">
      <div style="font-size:12px;letter-spacing:0.15em;text-transform:uppercase;color:#9e8e7e;margin-bottom:8px;">
        <t t-if="object.occurrence_id"><t t-out="object.occurrence_id.name"/></t>
        <t t-elif="object.class_interest == 'reformer'">Reformer Pilates</t>
        <t t-else="">Barre</t>
      </div>
      <div style="font-size:18px;font-weight:500;letter-spacing:-0.01em;"><t t-out="object.scheduled_datetime_display"/></div>
    </div>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">T'esperem a l'estudi. Si necessites canviar el dia, escriu-nos per l'app o per WhatsApp amb antelació.</p>
    <p style="margin:32px 0 0;font-size:14px;line-height:1.6;color:#9e8e7e;border-top:1px solid #e8e0d6;padding-top:24px;">CoreLab Studio · Matadepera, Barcelona<br/>Fins aviat.</p>
  </t>

  <t t-elif="object.lang == 'es_ES'">
    <p style="margin:0 0 28px;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#9e8e7e;">CoreLab Studio · Matadepera, Barcelona</p>
    <h1 style="margin:0 0 20px;font-size:32px;font-weight:400;line-height:1.2;letter-spacing:-0.02em;">Confirmado.</h1>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Hola <t t-out="object.name"/>, tu clase de prueba ha quedado confirmada:</p>
    <div style="margin:24px 0;padding:20px 24px;background:#f0ece6;border-radius:12px;">
      <div style="font-size:12px;letter-spacing:0.15em;text-transform:uppercase;color:#9e8e7e;margin-bottom:8px;">
        <t t-if="object.occurrence_id"><t t-out="object.occurrence_id.name"/></t>
        <t t-elif="object.class_interest == 'reformer'">Reformer Pilates</t>
        <t t-else="">Barre</t>
      </div>
      <div style="font-size:18px;font-weight:500;letter-spacing:-0.01em;"><t t-out="object.scheduled_datetime_display"/></div>
    </div>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Te esperamos en el estudio. Si necesitas cambiar el día, escríbenos por la app o por WhatsApp con antelación.</p>
    <p style="margin:32px 0 0;font-size:14px;line-height:1.6;color:#9e8e7e;border-top:1px solid #e8e0d6;padding-top:24px;">CoreLab Studio · Matadepera, Barcelona<br/>Hasta pronto.</p>
  </t>

  <t t-else="">
    <p style="margin:0 0 28px;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#9e8e7e;">CoreLab Studio · Matadepera, Barcelona</p>
    <h1 style="margin:0 0 20px;font-size:32px;font-weight:400;line-height:1.2;letter-spacing:-0.02em;">Confirmed.</h1>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Hi <t t-out="object.name"/>, your trial class is confirmed:</p>
    <div style="margin:24px 0;padding:20px 24px;background:#f0ece6;border-radius:12px;">
      <div style="font-size:12px;letter-spacing:0.15em;text-transform:uppercase;color:#9e8e7e;margin-bottom:8px;">
        <t t-if="object.occurrence_id"><t t-out="object.occurrence_id.name"/></t>
        <t t-elif="object.class_interest == 'reformer'">Reformer Pilates</t>
        <t t-else="">Barre</t>
      </div>
      <div style="font-size:18px;font-weight:500;letter-spacing:-0.01em;"><t t-out="object.scheduled_datetime_display"/></div>
    </div>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">We look forward to welcoming you. If you need to reschedule, message us in the app or on WhatsApp with as much notice as possible.</p>
    <p style="margin:32px 0 0;font-size:14px;line-height:1.6;color:#9e8e7e;border-top:1px solid #e8e0d6;padding-top:24px;">CoreLab Studio · Matadepera, Barcelona<br/>See you on the mat.</p>
  </t>

  <t t-set="notice_lang" t-value="object.lang"/>
  <t t-call="fitness_notifications.mail_footer_no_reply"/>
</div>
    </field>
  </record>

  <!-- ── Barre Trial: Admin Notification ─────────────────────────────────── -->
  <record id="mail_template_barre_trial_admin" model="mail.template">
    <field name="name">Trial: Admin Notification</field>
    <field name="model_id" ref="fitness_trials.model_fitness_trial_request"/>
    <field name="subject">New {{ object.class_interest and object.class_interest.capitalize() or '' }} trial booked — {{ object.name }}</field>
    <!-- Odoo defaults use_default_to to True, which ignores email_to and
         asks the record for its recipients instead. A trial submitted from
         the public form has no partner, so that returned nobody: the mail
         was created with no recipient, marked sent, and delivered to no
         one. The address typed on the form is the only one there is. -->
    <field name="use_default_to" eval="False"/>
    <field name="email_to"></field>
    <field name="auto_delete" eval="False"/>
    <field name="email_from">{{ user.company_id.email_formatted or '"CoreLab Studio" &lt;info@corelabstudio.es&gt;' }}</field>
    <field name="reply_to">{{ object.email or user.company_id.email_formatted }}</field>
    <field name="body_html" type="html">
<div style="font-family:Georgia,'Times New Roman',serif;max-width:560px;margin:0 auto;padding:40px 24px;color:#2c2c2c;background-color:#faf9f7;color-scheme:light only;supported-color-schemes:light only;">
  <p style="margin:0 0 28px;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#9e8e7e;">CoreLab Studio · Admin</p>
  <h1 style="margin:0 0 20px;font-size:26px;font-weight:400;line-height:1.2;letter-spacing:-0.02em;">New <t t-out="object.class_interest and object.class_interest.capitalize() or ''"/> Trial Booking</h1>
  <div style="margin:0 0 24px;padding:20px 24px;background:#f0ece6;border-radius:10px;">
    <table style="width:100%;border-collapse:collapse;font-size:15px;line-height:1.9;">
      <tr>
        <td style="color:#9e8e7e;padding-right:24px;white-space:nowrap;vertical-align:top;width:35%;">Name</td>
        <td style="font-weight:500;"><t t-out="object.name"/></td>
      </tr>
      <tr>
        <td style="color:#9e8e7e;padding-right:24px;white-space:nowrap;vertical-align:top;">Email</td>
        <td><t t-out="object.email"/></td>
      </tr>
      <t t-if="object.phone">
        <tr>
          <td style="color:#9e8e7e;padding-right:24px;white-space:nowrap;vertical-align:top;">Phone</td>
          <td><t t-out="object.phone"/></td>
        </tr>
      </t>
      <t t-if="object.occurrence_id">
        <tr>
          <td style="color:#9e8e7e;padding-right:24px;white-space:nowrap;vertical-align:top;">Class</td>
          <td><t t-out="object.occurrence_id.name"/></td>
        </tr>
        <tr>
          <td style="color:#9e8e7e;padding-right:24px;white-space:nowrap;vertical-align:top;">Date / Time</td>
          <td style="font-weight:500;"><t t-out="object.scheduled_datetime_display"/></td>
        </tr>
      </t>
    </table>
  </div>
  <p style="margin:0;font-size:13px;line-height:1.6;color:#9e8e7e;border-top:1px solid #e8e0d6;padding-top:20px;">
    Automated notification · CoreLab Studio trial booking system
  </p>
</div>
    </field>
  </record>

  <!-- ── Declined ─────────────────────────────────────────────────────────── -->
