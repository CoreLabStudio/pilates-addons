<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

  <!-- ── Pending (sent on creation) ──────────────────────────────────────── -->
  <record id="mail_template_trial_pending" model="mail.template">
    <field name="name">Trial Request: Received (EN/ES/CA)</field>
    <field name="model_id" ref="fitness_trials.model_fitness_trial_request"/>
    <field name="subject">{{ 'Trial class request received · CoreLab' if object.lang == 'en_US' else ('Sol·licitud de classe de prova rebuda · CoreLab' if object.lang == 'ca_ES' else 'Solicitud de clase de prueba recibida · CoreLab') }}</field>
    <field name="email_to">{{ object.email }}</field>
    <field name="auto_delete" eval="False"/>
    <field name="body_html" type="html">
<div style="font-family:Georgia,'Times New Roman',serif;max-width:560px;margin:0 auto;padding:40px 24px;color:#2c2c2c;background:#faf9f7;">

  <t t-if="object.lang == 'ca_ES'">
    <p style="margin:0 0 28px;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#9e8e7e;">CoreLab Studio · Lisboa</p>
    <h1 style="margin:0 0 20px;font-size:32px;font-weight:400;line-height:1.2;letter-spacing:-0.02em;">Hola, <t t-out="object.name"/>.</h1>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Hem rebut la teva sol·licitud de classe de prova. Ens posarem en contacte amb tu aviat per confirmar el dia i l'hora.</p>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Si tens cap pregunta, no dubtis en respondre a aquest correu.</p>
    <p style="margin:32px 0 0;font-size:14px;line-height:1.6;color:#9e8e7e;border-top:1px solid #e8e0d6;padding-top:24px;">CoreLab Studio · Príncipe Real, Lisboa<br/>Fins aviat.</p>
  </t>

  <t t-elif="object.lang == 'es_ES'">
    <p style="margin:0 0 28px;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#9e8e7e;">CoreLab Studio · Lisboa</p>
    <h1 style="margin:0 0 20px;font-size:32px;font-weight:400;line-height:1.2;letter-spacing:-0.02em;">Hola, <t t-out="object.name"/>.</h1>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Hemos recibido tu solicitud de clase de prueba. Nos pondremos en contacto contigo pronto para confirmar el día y la hora.</p>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Si tienes alguna pregunta, no dudes en responder a este correo.</p>
    <p style="margin:32px 0 0;font-size:14px;line-height:1.6;color:#9e8e7e;border-top:1px solid #e8e0d6;padding-top:24px;">CoreLab Studio · Príncipe Real, Lisboa<br/>Hasta pronto.</p>
  </t>

  <t t-else="">
    <p style="margin:0 0 28px;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#9e8e7e;">CoreLab Studio · Lisbon</p>
    <h1 style="margin:0 0 20px;font-size:32px;font-weight:400;line-height:1.2;letter-spacing:-0.02em;">Hello, <t t-out="object.name"/>.</h1>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Your trial class request has been received. We'll be in touch shortly to confirm a date and time that works for you.</p>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">If you have any questions in the meantime, feel free to reply to this email.</p>
    <p style="margin:32px 0 0;font-size:14px;line-height:1.6;color:#9e8e7e;border-top:1px solid #e8e0d6;padding-top:24px;">CoreLab Studio · Príncipe Real, Lisbon<br/>See you on the mat.</p>
  </t>

</div>
    </field>
  </record>

  <!-- ── Scheduled (sent when status→scheduled + datetime set) ───────────── -->
  <record id="mail_template_trial_scheduled" model="mail.template">
    <field name="name">Trial Request: Scheduled Confirmation (EN/ES/CA)</field>
    <field name="model_id" ref="fitness_trials.model_fitness_trial_request"/>
    <field name="subject">{{ 'Your CoreLab trial class is confirmed' if object.lang == 'en_US' else ('La teva classe de prova a CoreLab és confirmada' if object.lang == 'ca_ES' else 'Tu clase de prueba en CoreLab está confirmada') }}</field>
    <field name="email_to">{{ object.email }}</field>
    <field name="auto_delete" eval="False"/>
    <field name="body_html" type="html">
<div style="font-family:Georgia,'Times New Roman',serif;max-width:560px;margin:0 auto;padding:40px 24px;color:#2c2c2c;background:#faf9f7;">

  <t t-if="object.lang == 'ca_ES'">
    <p style="margin:0 0 28px;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#9e8e7e;">CoreLab Studio · Lisboa</p>
    <h1 style="margin:0 0 20px;font-size:32px;font-weight:400;line-height:1.2;letter-spacing:-0.02em;">Confirmat.</h1>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Hola <t t-out="object.name"/>, la teva classe de prova ha quedat confirmada:</p>
    <div style="margin:24px 0;padding:20px 24px;background:#f0ece6;border-radius:12px;font-size:18px;font-weight:500;letter-spacing:-0.01em;">
      <t t-out="object.scheduled_datetime_display"/>
    </div>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">T'esperem a l'estudi. Si necessites canviar el dia, respon a aquest correu amb antelació.</p>
    <p style="margin:32px 0 0;font-size:14px;line-height:1.6;color:#9e8e7e;border-top:1px solid #e8e0d6;padding-top:24px;">CoreLab Studio · Príncipe Real, Lisboa<br/>Fins aviat.</p>
  </t>

  <t t-elif="object.lang == 'es_ES'">
    <p style="margin:0 0 28px;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#9e8e7e;">CoreLab Studio · Lisboa</p>
    <h1 style="margin:0 0 20px;font-size:32px;font-weight:400;line-height:1.2;letter-spacing:-0.02em;">Confirmado.</h1>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Hola <t t-out="object.name"/>, tu clase de prueba ha quedado confirmada:</p>
    <div style="margin:24px 0;padding:20px 24px;background:#f0ece6;border-radius:12px;font-size:18px;font-weight:500;letter-spacing:-0.01em;">
      <t t-out="object.scheduled_datetime_display"/>
    </div>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Te esperamos en el estudio. Si necesitas cambiar el día, responde a este correo con antelación.</p>
    <p style="margin:32px 0 0;font-size:14px;line-height:1.6;color:#9e8e7e;border-top:1px solid #e8e0d6;padding-top:24px;">CoreLab Studio · Príncipe Real, Lisboa<br/>Hasta pronto.</p>
  </t>

  <t t-else="">
    <p style="margin:0 0 28px;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#9e8e7e;">CoreLab Studio · Lisbon</p>
    <h1 style="margin:0 0 20px;font-size:32px;font-weight:400;line-height:1.2;letter-spacing:-0.02em;">Confirmed.</h1>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Hi <t t-out="object.name"/>, your trial class is confirmed:</p>
    <div style="margin:24px 0;padding:20px 24px;background:#f0ece6;border-radius:12px;font-size:18px;font-weight:500;letter-spacing:-0.01em;">
      <t t-out="object.scheduled_datetime_display"/>
    </div>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">We look forward to welcoming you. If you need to reschedule, simply reply to this email with as much notice as possible.</p>
    <p style="margin:32px 0 0;font-size:14px;line-height:1.6;color:#9e8e7e;border-top:1px solid #e8e0d6;padding-top:24px;">CoreLab Studio · Príncipe Real, Lisbon<br/>See you on the mat.</p>
  </t>

</div>
    </field>
  </record>

  <!-- ── Declined ─────────────────────────────────────────────────────────── -->
  <record id="mail_template_trial_declined" model="mail.template">
    <field name="name">Trial Request: Declined (EN/ES/CA)</field>
    <field name="model_id" ref="fitness_trials.model_fitness_trial_request"/>
    <field name="subject">{{ 'About your CoreLab trial class request' if object.lang == 'en_US' else ('Sobre la teva sol·licitud de classe de prova a CoreLab' if object.lang == 'ca_ES' else 'Sobre tu solicitud de clase de prueba en CoreLab') }}</field>
    <field name="email_to">{{ object.email }}</field>
    <field name="auto_delete" eval="False"/>
    <field name="body_html" type="html">
<div style="font-family:Georgia,'Times New Roman',serif;max-width:560px;margin:0 auto;padding:40px 24px;color:#2c2c2c;background:#faf9f7;">

  <t t-if="object.lang == 'ca_ES'">
    <p style="margin:0 0 28px;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#9e8e7e;">CoreLab Studio · Lisboa</p>
    <h1 style="margin:0 0 20px;font-size:32px;font-weight:400;line-height:1.2;letter-spacing:-0.02em;">Hola, <t t-out="object.name"/>.</h1>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Gràcies per l'interès en CoreLab. En aquest moment no podem accommodar la teva sol·licitud de classe de prova, però t'animem a tornar a contactar-nos en el futur.</p>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Si tens preguntes o vols explorar altres opcions, respon a aquest correu i parlarem.</p>
    <p style="margin:32px 0 0;font-size:14px;line-height:1.6;color:#9e8e7e;border-top:1px solid #e8e0d6;padding-top:24px;">CoreLab Studio · Príncipe Real, Lisboa</p>
  </t>

  <t t-elif="object.lang == 'es_ES'">
    <p style="margin:0 0 28px;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#9e8e7e;">CoreLab Studio · Lisboa</p>
    <h1 style="margin:0 0 20px;font-size:32px;font-weight:400;line-height:1.2;letter-spacing:-0.02em;">Hola, <t t-out="object.name"/>.</h1>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Gracias por tu interés en CoreLab. En este momento no podemos acomodar tu solicitud de clase de prueba, pero te animamos a volver a contactarnos en el futuro.</p>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Si tienes preguntas o quieres explorar otras opciones, responde a este correo y hablamos.</p>
    <p style="margin:32px 0 0;font-size:14px;line-height:1.6;color:#9e8e7e;border-top:1px solid #e8e0d6;padding-top:24px;">CoreLab Studio · Príncipe Real, Lisboa</p>
  </t>

  <t t-else="">
    <p style="margin:0 0 28px;font-size:13px;letter-spacing:0.2em;text-transform:uppercase;color:#9e8e7e;">CoreLab Studio · Lisbon</p>
    <h1 style="margin:0 0 20px;font-size:32px;font-weight:400;line-height:1.2;letter-spacing:-0.02em;">Hello, <t t-out="object.name"/>.</h1>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">Thank you for your interest in CoreLab. Unfortunately we're not able to accommodate your trial class request at this time, but we hope to welcome you in the future.</p>
    <p style="margin:0 0 16px;font-size:16px;line-height:1.7;color:#4a4a4a;">If you have questions or would like to explore other options, please reply to this email and we'll be happy to help.</p>
    <p style="margin:32px 0 0;font-size:14px;line-height:1.6;color:#9e8e7e;border-top:1px solid #e8e0d6;padding-top:24px;">CoreLab Studio · Príncipe Real, Lisbon</p>
  </t>

</div>
    </field>
  </record>

</odoo>
