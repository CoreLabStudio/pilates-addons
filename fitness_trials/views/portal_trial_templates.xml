<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="trial_request_form" name="Trial Class Request Form">
        <t t-call="web.login_layout">

            <!-- Resolve language once; used throughout for t-if/_elif/_else branches. -->
            <t t-set="_lang" t-value="request.lang.code"/>

            <style>
                .mv-slot-card {
                    cursor: pointer;
                    border: 1px solid #dee2e6;
                    border-radius: 0.5rem;
                    padding: 0.75rem 1rem;
                    margin-bottom: 0.5rem;
                    display: flex;
                    align-items: flex-start;
                    gap: 0.75rem;
                    background: #fff;
                    transition: border-color 0.15s, background 0.15s;
                    width: 100%;
                }
                .mv-slot-card:hover { border-color: #9ABACD; background: #f4f9fb; }
                .mv-slot-card.mv-slot-selected { border-color: #9ABACD; background: #e8f3f8; }
                .mv-slot-card input[type="radio"] { margin-top: 0.2rem; flex-shrink: 0; }
                .mv-date-filters {
                    display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px;
                }
                .mv-date-pill {
                    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.04em;
                    padding: 4px 12px; border-radius: 20px;
                    border: 1.5px solid #c8bfb8; background: #fff; color: #357393;
                    cursor: pointer; transition: background 0.15s, border-color 0.15s, color 0.15s;
                    white-space: nowrap;
                }
                .mv-date-pill:hover { border-color: #9ABACD; }
                .mv-date-pill.mv-active { background: #7A6458; border-color: #7A6458; color: #fff; }
            </style>

            <!-- ── Success state ───────────────────────────────────────── -->
            <t t-if="success">
                <div class="text-center mb-4 mt-2">
                    <div style="font-size:2rem;margin-bottom:0.75rem;">✓</div>
                    <h5 class="fw-semibold mb-2">
                        <t t-if="_lang == 'en_US'">Request received</t>
                        <t t-elif="_lang == 'ca_ES'">Sol·licitud rebuda</t>
                        <t t-else="">Solicitud recibida</t>
                    </h5>
                    <p class="text-muted small mb-0">
                        <t t-if="_lang == 'en_US'">The studio will confirm your class shortly. We have emailed you a copy of your request.</t>
                        <t t-elif="_lang == 'ca_ES'">L'estudi et confirmarà la classe ben aviat. T'hem enviat una còpia de la teva sol·licitud per correu.</t>
                        <t t-else="">El estudio te confirmará la clase en breve. Te hemos enviado una copia de tu solicitud por correo.</t>
                    </p>
                </div>
                <!-- Not "submit another request": there is one trial per
                     person, so inviting a second one offered something that
                     would be refused. The page ends by looking forward to
                     the class and handing them back to the site. -->
                <p class="text-center fw-semibold mt-3 mb-2" style="color:#7a6458;">
                    <t t-if="_lang == 'en_US'">We can’t wait to meet you.</t>
                    <t t-elif="_lang == 'ca_ES'">Tenim moltes ganes de conèixer-te.</t>
                    <t t-else="">¡Estamos deseando conocerte!</t>
                </p>
                <div class="text-center mt-2">
                    <a href="https://corelabstudio.es" class="btn btn-link btn-sm text-muted">
                        <t t-if="_lang == 'en_US'">Back to corelabstudio.es</t>
                        <t t-elif="_lang == 'ca_ES'">Tornar a corelabstudio.es</t>
                        <t t-else="">Volver a corelabstudio.es</t>
                    </a>
                </div>
            </t>

            <!-- ── Form state ───────────────────────────────────────────── -->
            <t t-else="">
                <div class="text-center mb-4 mt-1">
                    <h5 class="fw-semibold mb-1">
                        <t t-if="_lang == 'en_US'">Request a trial class</t>
                        <t t-elif="_lang == 'ca_ES'">Sol·licitar una classe de prova</t>
                        <t t-else="">Solicitar clase de prueba</t>
                    </h5>
                    <p class="text-muted small mb-0">
                        <t t-if="_lang == 'en_US'">Choose your class type and fill in the form.</t>
                        <t t-elif="_lang == 'ca_ES'">Tria el tipus de classe i omple el formulari.</t>
                        <t t-else="">Elige el tipo de clase y rellena el formulario.</t>
                    </p>
                </div>

                <t t-if="error">
                    <div class="alert alert-danger small mb-3" role="alert">
                        <t t-esc="error"/>
                    </div>
                </t>

                <form method="post" action="/trial/submit" class="mv-trial-form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <!-- Which entry point this was. Stamped here rather than
                         inferred from the session: somebody can be signed in
                         and still be reading the public site. -->
                    <input type="hidden" name="source" t-att-value="source or 'website'"/>

                    <!-- ── Name ───────────────────────────────────────────── -->
                    <div class="mb-3">
                        <label for="trial_name" class="form-label">
                            <t t-if="_lang == 'en_US'">Name</t>
                            <t t-elif="_lang == 'ca_ES'">Nom</t>
                            <t t-else="">Nombre</t>
                            <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="trial_name" name="name" class="form-control"
                               required="required" autocomplete="name"
                               t-att-value="form_values.get('name', '')"/>
                    </div>

                    <!-- ── Email ──────────────────────────────────────────── -->
                    <div class="mb-3">
                        <label for="trial_email" class="form-label">
                            <t t-if="_lang == 'en_US'">Email</t>
                            <t t-elif="_lang == 'ca_ES'">Correu electrònic</t>
                            <t t-else="">Correo electrónico</t>
                            <span class="text-danger">*</span>
                        </label>
                        <input type="email" id="trial_email" name="email" class="form-control"
                               required="required" autocomplete="email"
                               t-att-value="form_values.get('email', '')"/>
                    </div>

                    <!-- ── Phone ──────────────────────────────────────────── -->
                    <div class="mb-3">
                        <label for="trial_phone" class="form-label">
                            <t t-if="_lang == 'en_US'">Phone <span class="text-muted small">(optional)</span></t>
                            <t t-elif="_lang == 'ca_ES'">Telèfon <span class="text-muted small">(opcional)</span></t>
                            <t t-else="">Teléfono <span class="text-muted small">(opcional)</span></t>
                        </label>
                        <input type="tel" id="trial_phone" name="phone" class="form-control"
                               autocomplete="tel"
                               t-att-value="form_values.get('phone', '')"/>
                    </div>

                    <!-- ── Class interest ──────────────────────────────────── -->
                    <div class="mb-3">
                        <label class="form-label">
                            <t t-if="_lang == 'en_US'">Class type</t>
                            <t t-elif="_lang == 'ca_ES'">Tipus de classe</t>
                            <t t-else="">Tipo de clase</t>
                            <span class="text-danger">*</span>
                        </label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="class_interest"
                                       id="ci_barre" value="barre"
                                       t-att-checked="'checked' if form_values.get('class_interest') == 'barre' else None"/>
                                <label class="form-check-label" for="ci_barre">
                                    <strong>Barre</strong>
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="class_interest"
                                       id="ci_reformer" value="reformer"
                                       t-att-checked="'checked' if form_values.get('class_interest') == 'reformer' else None"/>
                                <label class="form-check-label" for="ci_reformer">
                                    <strong>Reformer</strong>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Which class, within the discipline chosen above. Both
                         lists are rendered and the script shows the one that
                         matches, so switching discipline needs no round trip. -->
                    <div id="mv-barre-section" class="mv-trial-conditional d-none mb-3">
                        <label class="form-label">
                            <t t-if="_lang == 'en_US'">Which Barre class?</t>
                            <t t-elif="_lang == 'ca_ES'">Quina classe de Barre?</t>
                            <t t-else="">¿Qué clase de Barre?</t>
                            <span class="text-danger">*</span>
                        </label>
                        <t t-foreach="barre_types" t-as="ct">
                            <label class="mv-slot-card" t-att-for="'bct_' + str(ct['id'])">
                                <input type="radio" name="class_type_id"
                                       t-att-id="'bct_' + str(ct['id'])"
                                       t-att-value="ct['id']"
                                       t-att-checked="'checked' if str(form_values.get('class_type_id', '')) == str(ct['id']) else None"/>
                                <div style="flex:1;min-width:0;">
                                    <div class="fw-semibold small" style="color:#3a3330;" t-esc="ct['name']"/>
                                    <t t-if="ct['duration']">
                                        <div class="small text-muted"><t t-esc="int(ct['duration'])"/> min</div>
                                    </t>
                                </div>
                            </label>
                        </t>
                    </div>

                    <div id="mv-reformer-section" class="mv-trial-conditional d-none mb-3">
                        <label class="form-label">
                            <t t-if="_lang == 'en_US'">Which Reformer class?</t>
                            <t t-elif="_lang == 'ca_ES'">Quina classe de Reformer?</t>
                            <t t-else="">¿Qué clase de Reformer?</t>
                            <span class="text-danger">*</span>
                        </label>
                        <t t-foreach="reformer_types" t-as="ct">
                            <label class="mv-slot-card" t-att-for="'rct_' + str(ct['id'])">
                                <input type="radio" name="class_type_id"
                                       t-att-id="'rct_' + str(ct['id'])"
                                       t-att-value="ct['id']"
                                       t-att-checked="'checked' if str(form_values.get('class_type_id', '')) == str(ct['id']) else None"/>
                                <div style="flex:1;min-width:0;">
                                    <div class="fw-semibold small" style="color:#3a3330;" t-esc="ct['name']"/>
                                    <t t-if="ct['duration']">
                                        <div class="small text-muted"><t t-esc="int(ct['duration'])"/> min</div>
                                    </t>
                                </div>
                            </label>
                        </t>
                    </div>

                    <!-- When they would like to come. A preference, not a
                         booking: the studio still chooses the actual class,
                         which is the whole point of the three-student minimum. -->
                    <div class="mb-3">
                        <label class="form-label" for="trial_preferred_date">
                            <t t-if="_lang == 'en_US'">Preferred date</t>
                            <t t-elif="_lang == 'ca_ES'">Data preferida</t>
                            <t t-else="">Fecha preferida</t>
                            <span class="text-danger">*</span>
                        </label>
                        <input type="date" id="trial_preferred_date" name="preferred_date"
                               class="form-control" required="required"
                               t-att-min="today_iso"
                               t-att-value="form_values.get('preferred_date', '')"/>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            <t t-if="_lang == 'en_US'">Morning or evening?</t>
                            <t t-elif="_lang == 'ca_ES'">Matí o tarda?</t>
                            <t t-else="">¿Mañana o tarde?</t>
                            <span class="text-danger">*</span>
                        </label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="preferred_period"
                                       id="pp_morning" value="morning" required="required"
                                       t-att-checked="'checked' if form_values.get('preferred_period') == 'morning' else None"/>
                                <label class="form-check-label" for="pp_morning">
                                    <t t-if="_lang == 'en_US'">Morning</t>
                                    <t t-elif="_lang == 'ca_ES'">Matí</t>
                                    <t t-else="">Mañana</t>
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="preferred_period"
                                       id="pp_evening" value="evening"
                                       t-att-checked="'checked' if form_values.get('preferred_period') == 'evening' else None"/>
                                <label class="form-check-label" for="pp_evening">
                                    <t t-if="_lang == 'en_US'">Evening</t>
                                    <t t-elif="_lang == 'ca_ES'">Tarda</t>
                                    <t t-else="">Tarde</t>
                                </label>
                            </div>
                        </div>
                    </div>


                    <!-- ── Submit ─────────────────────────────────────── -->
                    <div class="d-grid mt-2">
                        <button type="submit" id="mv-trial-submit" class="btn btn-primary" disabled="disabled"
                                t-att-data-sending="'Sending\u2026' if _lang == 'en_US' else ('Enviant\u2026' if _lang == 'ca_ES' else 'Enviando\u2026')">
                            <t t-if="_lang == 'en_US'">Submit request</t>
                            <t t-elif="_lang == 'ca_ES'">Envia la sol·licitud</t>
                            <t t-else="">Enviar solicitud</t>
                        </button>
                    </div>
                    <p class="text-center small text-muted mt-3 mb-0">
                        <t t-if="_lang == 'en_US'">Already have an account? <a href="/web/login" class="text-decoration-none">Log in</a></t>
                        <t t-elif="_lang == 'ca_ES'">Ja tens compte? <a href="/web/login" class="text-decoration-none">Inicia sessió</a></t>
                        <t t-else="">¿Ya tienes cuenta? <a href="/web/login" class="text-decoration-none">Inicia sesión</a></t>
                    </p>
                </form>

                <script>
                (function () {
                    var ciRadios     = document.querySelectorAll('input[name="class_interest"]');
                    var barreSection = document.getElementById('mv-barre-section');
                    var rfSection    = document.getElementById('mv-reformer-section');
                    var submitBtn    = document.getElementById('mv-trial-submit');

                    function updateSubmit() {
                        var ci = document.querySelector('input[name="class_interest"]:checked');
                        // Both disciplines need a chosen class now - Reformer used
                        // to enable on the questions alone.
                        var enabled = !!(ci &amp;&amp;
                            document.querySelector('input[name="class_type_id"]:checked') &amp;&amp;
                            (document.getElementById('trial_preferred_date') || {}).value &amp;&amp;
                            document.querySelector('input[name="preferred_period"]:checked'));
                        if (enabled) {
                            submitBtn.removeAttribute('disabled');
                            submitBtn.disabled = false;
                        } else {
                            submitBtn.disabled = true;
                        }
                    }

                    function showSection(val) {
                        barreSection.classList.toggle('d-none', val !== 'barre');
                        rfSection.classList.toggle('d-none', val !== 'reformer');
                        updateSubmit();
                    }

                    // Class interest change
                    ciRadios.forEach(function (r) {
                        r.addEventListener('change', function () { showSection(this.value); });
                    });

                    // Slot selection — update submit state + highlight card
                    function onSlotChange(e) {
                        if (e.target &amp;&amp; e.target.name === 'class_type_id') {
                            document.querySelectorAll('.mv-slot-card').forEach(function (c) {
                                c.classList.remove('mv-slot-selected');
                            });
                            if (e.target.checked) {
                                var card = e.target.closest('.mv-slot-card');
                                if (card) { card.classList.add('mv-slot-selected'); }
                            }
                            updateSubmit();
                        }
                    }
                    barreSection.addEventListener('change', onSlotChange);
                    rfSection.addEventListener('change', onSlotChange);

                    // Initialise on page load (restores state after server-side re-render on error)
                    var checkedCi = document.querySelector('input[name="class_interest"]:checked');
                    if (checkedCi) { showSection(checkedCi.value); }

                    var checkedType = document.querySelector('input[name="class_type_id"]:checked');
                    if (checkedType) {
                        var card = checkedType.closest('.mv-slot-card');
                        if (card) { card.classList.add('mv-slot-selected'); }
                    }

                    // A submit that takes a moment invites a second click, and
                    // a second click used to mean a second booking. The button
                    // goes dead and says so the instant the form is sent.
                    var trialForm = document.querySelector('form[action="/trial/submit"]');
                    if (trialForm) {
                        trialForm.addEventListener('submit', function () {
                            if (submitBtn) {
                                submitBtn.disabled = true;
                                submitBtn.textContent = submitBtn.dataset.sending || 'Enviando\u2026';
                            }
                        });
                    }
                })();
                </script>
            </t>

        </t>
    </template>

</odoo>
