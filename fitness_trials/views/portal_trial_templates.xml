<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="trial_request_form" name="Trial Class Request Form">
        <t t-call="web.login_layout">

            <!-- Resolve language once; used throughout for t-if/_elif/_else branches. -->
            <t t-set="_lang" t-value="request.lang.code"/>

            <style>
                .mv-slot-card {
                    cursor: pointer;
                    border: 1px solid #dee2e6;
                    border-radius: 0.5rem;
                    padding: 0.75rem 1rem;
                    margin-bottom: 0.5rem;
                    display: flex;
                    align-items: flex-start;
                    gap: 0.75rem;
                    background: #fff;
                    transition: border-color 0.15s, background 0.15s;
                    width: 100%;
                }
                .mv-slot-card:hover { border-color: #9ABACD; background: #f4f9fb; }
                .mv-slot-card.mv-slot-selected { border-color: #9ABACD; background: #e8f3f8; }
                .mv-slot-card input[type="radio"] { margin-top: 0.2rem; flex-shrink: 0; }
                .mv-date-filters {
                    display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px;
                }
                .mv-date-pill {
                    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.04em;
                    padding: 4px 12px; border-radius: 20px;
                    border: 1.5px solid #c8bfb8; background: #fff; color: #357393;
                    cursor: pointer; transition: background 0.15s, border-color 0.15s, color 0.15s;
                    white-space: nowrap;
                }
                .mv-date-pill:hover { border-color: #9ABACD; }
                .mv-date-pill.mv-active { background: #7A6458; border-color: #7A6458; color: #fff; }
            </style>

            <!-- ── Success state ───────────────────────────────────────── -->
            <t t-if="success">
                <div class="text-center mb-4 mt-2">
                    <div style="font-size:2rem;margin-bottom:0.75rem;">✓</div>
                    <h5 class="fw-semibold mb-2">
                        <t t-if="_lang == 'en_US'">Trial class confirmed!</t>
                        <t t-elif="_lang == 'ca_ES'">Classe de prova confirmada!</t>
                        <t t-else="">¡Clase de prueba confirmada!</t>
                    </h5>
                    <t t-if="submitted_slot">
                        <p class="small fw-semibold mb-1" style="color:#4a4a4a;">
                            <t t-esc="submitted_slot['name']"/>
                            · <t t-esc="submitted_slot['day']"/>
                            <t t-esc="submitted_slot['day_num']"/>
                            <t t-esc="submitted_slot['month']"/>
                            · <t t-esc="submitted_slot['time']"/>
                            <t t-if="submitted_slot['duration']">
                                · <t t-esc="submitted_slot['duration']"/> min
                            </t>
                        </p>
                    </t>
                    <p class="text-muted small mb-0">
                        <t t-if="_lang == 'en_US'">We have sent a confirmation email to your address.</t>
                        <t t-elif="_lang == 'ca_ES'">Hem enviat un correu de confirmació a la teva adreça.</t>
                        <t t-else="">Hemos enviado un email de confirmación a tu dirección.</t>
                    </p>
                </div>
                <!-- Not "submit another request": there is one trial per
                     person, so inviting a second one offered something that
                     would be refused. The page ends by looking forward to
                     the class and handing them back to the site. -->
                <p class="text-center fw-semibold mt-3 mb-2" style="color:#7a6458;">
                    <t t-if="_lang == 'en_US'">We can’t wait to meet you.</t>
                    <t t-elif="_lang == 'ca_ES'">Tenim moltes ganes de conèixer-te.</t>
                    <t t-else="">¡Estamos deseando conocerte!</t>
                </p>
                <div class="text-center mt-2">
                    <a href="https://corelabstudio.es" class="btn btn-link btn-sm text-muted">
                        <t t-if="_lang == 'en_US'">Back to corelabstudio.es</t>
                        <t t-elif="_lang == 'ca_ES'">Tornar a corelabstudio.es</t>
                        <t t-else="">Volver a corelabstudio.es</t>
                    </a>
                </div>
            </t>

            <!-- ── Form state ───────────────────────────────────────────── -->
            <t t-else="">
                <div class="text-center mb-4 mt-1">
                    <h5 class="fw-semibold mb-1">
                        <t t-if="_lang == 'en_US'">Request a trial class</t>
                        <t t-elif="_lang == 'ca_ES'">Sol·licitar una classe de prova</t>
                        <t t-else="">Solicitar clase de prueba</t>
                    </h5>
                    <p class="text-muted small mb-0">
                        <t t-if="_lang == 'en_US'">Choose your class type and fill in the form.</t>
                        <t t-elif="_lang == 'ca_ES'">Tria el tipus de classe i omple el formulari.</t>
                        <t t-else="">Elige el tipo de clase y rellena el formulario.</t>
                    </p>
                </div>

                <t t-if="error">
                    <div class="alert alert-danger small mb-3" role="alert">
                        <t t-esc="error"/>
                    </div>
                </t>

                <form method="post" action="/trial/submit" class="mv-trial-form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <!-- ── Name ───────────────────────────────────────────── -->
                    <div class="mb-3">
                        <label for="trial_name" class="form-label">
                            <t t-if="_lang == 'en_US'">Name</t>
                            <t t-elif="_lang == 'ca_ES'">Nom</t>
                            <t t-else="">Nombre</t>
                            <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="trial_name" name="name" class="form-control"
                               required="required" autocomplete="name"
                               t-att-value="form_values.get('name', '')"/>
                    </div>

                    <!-- ── Email ──────────────────────────────────────────── -->
                    <div class="mb-3">
                        <label for="trial_email" class="form-label">
                            <t t-if="_lang == 'en_US'">Email</t>
                            <t t-elif="_lang == 'ca_ES'">Correu electrònic</t>
                            <t t-else="">Correo electrónico</t>
                            <span class="text-danger">*</span>
                        </label>
                        <input type="email" id="trial_email" name="email" class="form-control"
                               required="required" autocomplete="email"
                               t-att-value="form_values.get('email', '')"/>
                    </div>

                    <!-- ── Phone ──────────────────────────────────────────── -->
                    <div class="mb-3">
                        <label for="trial_phone" class="form-label">
                            <t t-if="_lang == 'en_US'">Phone <span class="text-muted small">(optional)</span></t>
                            <t t-elif="_lang == 'ca_ES'">Telèfon <span class="text-muted small">(opcional)</span></t>
                            <t t-else="">Teléfono <span class="text-muted small">(opcional)</span></t>
                        </label>
                        <input type="tel" id="trial_phone" name="phone" class="form-control"
                               autocomplete="tel"
                               t-att-value="form_values.get('phone', '')"/>
                    </div>

                    <!-- ── Class interest ──────────────────────────────────── -->
                    <div class="mb-3">
                        <label class="form-label">
                            <t t-if="_lang == 'en_US'">Class type</t>
                            <t t-elif="_lang == 'ca_ES'">Tipus de classe</t>
                            <t t-else="">Tipo de clase</t>
                            <span class="text-danger">*</span>
                        </label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="class_interest"
                                       id="ci_barre" value="barre"
                                       t-att-checked="'checked' if form_values.get('class_interest') == 'barre' else None"/>
                                <label class="form-check-label" for="ci_barre">
                                    <strong>Barre</strong>
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="class_interest"
                                       id="ci_reformer" value="reformer"
                                       t-att-checked="'checked' if form_values.get('class_interest') == 'reformer' else None"/>
                                <label class="form-check-label" for="ci_reformer">
                                    <strong>Reformer</strong>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- ── Barre section: live slot picker ────────────────── -->
                    <div id="mv-barre-section" class="mv-trial-conditional d-none"
                         t-att-data-lang="request.lang.code"
                         t-att-data-today="'Today' if _lang == 'en_US' else ('Avui' if _lang == 'ca_ES' else 'Hoy')"
                         t-att-data-tomorrow="'Tomorrow' if _lang == 'en_US' else ('Demà' if _lang == 'ca_ES' else 'Mañana')"
                    >

                        <p class="small fw-semibold mb-2" style="color:#7a6a5a;text-transform:uppercase;letter-spacing:0.05em;font-size:0.78rem;">
                            <t t-if="_lang == 'en_US'">Select your Barre class</t>
                            <t t-elif="_lang == 'ca_ES'">Selecciona la teva classe de Barre</t>
                            <t t-else="">Selecciona tu clase de Barre</t>
                        </p>

                        <t t-if="barre_slots">
                            <t t-foreach="barre_slots" t-as="slot">
                                <label class="mv-slot-card"
                                       t-att-for="'slot_' + str(slot['id'])"
                                       t-att-data-date="str(slot['start_utc'].date())">
                                    <input type="radio" name="occurrence_id"
                                           t-att-id="'slot_' + str(slot['id'])"
                                           t-att-value="slot['id']"
                                           t-att-checked="'checked' if str(form_values.get('occurrence_id', '')) == str(slot['id']) else None"/>
                                    <div style="flex:1;min-width:0;">
                                        <div class="fw-semibold small" style="color:#3a3330;">
                                            <t t-esc="slot['day']"/>
                                            <t t-esc="slot['day_num']"/>
                                            <t t-esc="slot['month']"/>
                                            · <t t-esc="slot['time']"/>
                                        </div>
                                        <div class="small text-muted mt-1">
                                            <t t-esc="slot['name']"/>
                                            <t t-if="slot['duration']">
                                                · <t t-esc="slot['duration']"/> min
                                            </t>
                                            <t t-if="slot['teacher']">
                                                · <t t-esc="slot['teacher']"/>
                                            </t>
                                        </div>
                                    </div>
                                </label>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="alert alert-light small text-center mb-3">
                                <t t-if="_lang == 'en_US'">No Barre classes available in the next 14 days. Contact us directly to find a suitable time.</t>
                                <t t-elif="_lang == 'ca_ES'">No hi ha classes de Barre disponibles els pròxims 14 dies. Contacta'ns directament per trobar un horari.</t>
                                <t t-else="">No hay clases de Barre disponibles en los próximos 14 días. Contáctanos directamente para encontrar un horario.</t>
                            </div>
                        </t>

                    </div>

                    <!-- ── Reformer section: the same live slot picker ─────
                         Reformer used to ask about experience here and wait for
                         the studio to confirm. It books like Barre now: pick a
                         class, done. The questions and the preferred-times box
                         are gone with it - nothing reads them any more, and the
                         fields stay on the model so past requests keep theirs.
                    -->
                    <div id="mv-reformer-section" class="mv-trial-conditional d-none"
                         t-att-data-lang="request.lang.code"
                         t-att-data-today="'Today' if _lang == 'en_US' else ('Avui' if _lang == 'ca_ES' else 'Hoy')"
                         t-att-data-tomorrow="'Tomorrow' if _lang == 'en_US' else ('Dem\xe0' if _lang == 'ca_ES' else 'Ma\xf1ana')"
                    >

                        <p class="small fw-semibold mb-2" style="color:#7a6a5a;text-transform:uppercase;letter-spacing:0.05em;font-size:0.78rem;">
                            <t t-if="_lang == 'en_US'">Select your Reformer class</t>
                            <t t-elif="_lang == 'ca_ES'">Selecciona la teva classe de Reformer</t>
                            <t t-else="">Selecciona tu clase de Reformer</t>
                        </p>

                        <t t-if="reformer_slots">
                            <t t-foreach="reformer_slots" t-as="slot">
                                <label class="mv-slot-card"
                                       t-att-for="'rslot_' + str(slot['id'])"
                                       t-att-data-date="str(slot['start_utc'].date())">
                                    <input type="radio" name="occurrence_id"
                                           t-att-id="'rslot_' + str(slot['id'])"
                                           t-att-value="slot['id']"
                                           t-att-checked="'checked' if str(form_values.get('occurrence_id', '')) == str(slot['id']) else None"/>
                                    <div style="flex:1;min-width:0;">
                                        <div class="fw-semibold small" style="color:#3a3330;">
                                            <t t-esc="slot['day']"/>
                                            <t t-esc="slot['day_num']"/>
                                            <t t-esc="slot['month']"/>
                                            · <t t-esc="slot['time']"/>
                                        </div>
                                        <div class="small text-muted mt-1">
                                            <t t-esc="slot['name']"/>
                                            <t t-if="slot['duration']">
                                                · <t t-esc="slot['duration']"/> min
                                            </t>
                                            <t t-if="slot['teacher']">
                                                · <t t-esc="slot['teacher']"/>
                                            </t>
                                        </div>
                                    </div>
                                </label>
                            </t>
                        </t>
                        <t t-else="">
                            <div class="alert alert-light small text-center mb-3">
                                <t t-if="_lang == 'en_US'">No Reformer classes available in the next 14 days. Contact us directly to find a suitable time.</t>
                                <t t-elif="_lang == 'ca_ES'">No hi ha classes de Reformer disponibles els pr\xf2xims 14 dies. Contacta'ns directament per trobar un horari.</t>
                                <t t-else="">No hay clases de Reformer disponibles en los pr\xf3ximos 14 d\xedas. Cont\xe1ctanos directamente para encontrar un horario.</t>
                            </div>
                        </t>

                    </div>

                    <!-- ── Submit ─────────────────────────────────────── -->
                    <div class="d-grid mt-2">
                        <button type="submit" id="mv-trial-submit" class="btn btn-primary" disabled="disabled">
                            <t t-if="_lang == 'en_US'">Submit request</t>
                            <t t-elif="_lang == 'ca_ES'">Envia la sol·licitud</t>
                            <t t-else="">Enviar solicitud</t>
                        </button>
                    </div>
                    <p class="text-center small text-muted mt-3 mb-0">
                        <t t-if="_lang == 'en_US'">Already have an account? <a href="/web/login" class="text-decoration-none">Log in</a></t>
                        <t t-elif="_lang == 'ca_ES'">Ja tens compte? <a href="/web/login" class="text-decoration-none">Inicia sessió</a></t>
                        <t t-else="">¿Ya tienes cuenta? <a href="/web/login" class="text-decoration-none">Inicia sesión</a></t>
                    </p>
                </form>

                <script>
                (function () {
                    var ciRadios     = document.querySelectorAll('input[name="class_interest"]');
                    var barreSection = document.getElementById('mv-barre-section');
                    var rfSection    = document.getElementById('mv-reformer-section');
                    var submitBtn    = document.getElementById('mv-trial-submit');

                    function updateSubmit() {
                        var ci = document.querySelector('input[name="class_interest"]:checked');
                        // Both disciplines need a chosen class now - Reformer used
                        // to enable on the questions alone.
                        var enabled = !!(ci &amp;&amp;
                            document.querySelector('input[name="occurrence_id"]:checked'));
                        if (enabled) {
                            submitBtn.removeAttribute('disabled');
                            submitBtn.disabled = false;
                        } else {
                            submitBtn.disabled = true;
                        }
                    }

                    function showSection(val) {
                        barreSection.classList.toggle('d-none', val !== 'barre');
                        rfSection.classList.toggle('d-none', val !== 'reformer');
                        updateSubmit();
                    }

                    // Class interest change
                    ciRadios.forEach(function (r) {
                        r.addEventListener('change', function () { showSection(this.value); });
                    });

                    // Slot selection — update submit state + highlight card
                    function onSlotChange(e) {
                        if (e.target &amp;&amp; e.target.name === 'occurrence_id') {
                            document.querySelectorAll('.mv-slot-card').forEach(function (c) {
                                c.classList.remove('mv-slot-selected');
                            });
                            if (e.target.checked) {
                                var card = e.target.closest('.mv-slot-card');
                                if (card) { card.classList.add('mv-slot-selected'); }
                            }
                            updateSubmit();
                        }
                    }
                    barreSection.addEventListener('change', onSlotChange);
                    rfSection.addEventListener('change', onSlotChange);

                    // Initialise on page load (restores state after server-side re-render on error)
                    var checkedCi = document.querySelector('input[name="class_interest"]:checked');
                    if (checkedCi) { showSection(checkedCi.value); }

                    var checkedSlot = document.querySelector('input[name="occurrence_id"]:checked');
                    if (checkedSlot) {
                        var card = checkedSlot.closest('.mv-slot-card');
                        if (card) { card.classList.add('mv-slot-selected'); }
                    }

                    // ── Date filter pills (client-side) ──────────────────
                    // Written for Barre alone; Reformer had no slot list to
                    // filter. Both lists get pills now, so this takes the
                    // section rather than closing over one.
                    function buildDatePills(section) {
                        if (!section) { return; }
                        var allCards = section.querySelectorAll('.mv-slot-card[data-date]');
                        if (!allCards.length) { return; }

                        var _lblToday    = section.dataset.today    || 'Hoy';
                        var _lblTomorrow = section.dataset.tomorrow || 'Mañana';
                        var _lang        = section.dataset.lang     || 'es_ES';

                        var nowD      = new Date();
                        var todayStr  = nowD.getFullYear() + '-' +
                                        String(nowD.getMonth() + 1).padStart(2, '0') + '-' +
                                        String(nowD.getDate()).padStart(2, '0');
                        var tD = new Date(nowD.getFullYear(), nowD.getMonth(), nowD.getDate() + 1);
                        var tomorrowStr = tD.getFullYear() + '-' +
                                          String(tD.getMonth() + 1).padStart(2, '0') + '-' +
                                          String(tD.getDate()).padStart(2, '0');

                        function labelDate(dStr) {
                            if (dStr === todayStr)    { return _lblToday; }
                            if (dStr === tomorrowStr) { return _lblTomorrow; }
                            try {
                                var p  = dStr.split('-');
                                var d  = new Date(+p[0], +p[1] - 1, +p[2]);
                                var lc = _lang.replace('_', '-');
                                var wd = d.toLocaleDateString(lc, {weekday: 'short'})
                                           .replace(/\./g, '').trim();
                                return wd.charAt(0).toUpperCase() + wd.slice(1) + ' ' + (+p[2]);
                            } catch (e) { return dStr; }
                        }

                        // Collect unique ordered dates from slot cards
                        var seenSet = {}, seenDates = [];
                        allCards.forEach(function (c) {
                            var d = c.dataset.date;
                            if (d) {
                                if (!seenSet[d]) { seenSet[d] = true; seenDates.push(d); }
                            }
                        });
                        if (!seenDates.length) { return; }

                        // Build pills and insert before first slot card
                        var pillsWrap = document.createElement('div');
                        pillsWrap.className = 'mv-date-filters';
                        pillsWrap.id = 'mv-date-pills-' + (section.id || 'x');
                        var datePills = [];
                        seenDates.forEach(function (dStr) {
                            var btn = document.createElement('button');
                            btn.type = 'button';
                            btn.className = 'mv-date-pill';
                            btn.dataset.date = dStr;
                            btn.textContent = labelDate(dStr);
                            pillsWrap.appendChild(btn);
                            datePills.push(btn);
                        });
                        allCards[0].parentNode.insertBefore(pillsWrap, allCards[0]);

                        function applyDateFilter(activeDate) {
                            allCards.forEach(function (card) {
                                card.style.display = (!activeDate || card.dataset.date === activeDate) ? '' : 'none';
                            });
                            var checked = document.querySelector('input[name="occurrence_id"]:checked');
                            if (checked) {
                                var pc = checked.closest('.mv-slot-card');
                                if (pc) {
                                    if (pc.style.display === 'none') {
                                        checked.checked = false;
                                        allCards.forEach(function (c) { c.classList.remove('mv-slot-selected'); });
                                        updateSubmit();
                                    }
                                }
                            }
                        }

                        datePills.forEach(function (pill) {
                            pill.addEventListener('click', function () {
                                datePills.forEach(function (p) { p.classList.remove('mv-active'); });
                                this.classList.add('mv-active');
                                applyDateFilter(this.dataset.date);
                            });
                        });

                        // Auto-select: pre-checked slot's date (error re-render) or nearest future
                        var defaultDate = null;
                        var preChecked = document.querySelector('input[name="occurrence_id"]:checked');
                        if (preChecked) {
                            var preCard = preChecked.closest('.mv-slot-card');
                            if (preCard) { defaultDate = preCard.dataset.date || null; }
                        }
                        if (!defaultDate) {
                            seenDates.forEach(function (dStr) {
                                if (!defaultDate) {
                                    if (dStr >= todayStr) { defaultDate = dStr; }
                                }
                            });
                        }
                        if (defaultDate) {
                            datePills.forEach(function (pill) {
                                if (pill.dataset.date === defaultDate) { pill.classList.add('mv-active'); }
                            });
                            applyDateFilter(defaultDate);
                        }
                    }

                    buildDatePills(barreSection);
                    buildDatePills(rfSection);
                })();
                </script>
            </t>

        </t>
    </template>

</odoo>
