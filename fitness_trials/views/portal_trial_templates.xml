<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="trial_request_form" name="Trial Class Request Form">
        <t t-call="web.login_layout">

            <!-- Resolve language once; used throughout for t-if/_elif/_else branches. -->
            <t t-set="_lang" t-value="request.lang.code"/>

            <style>
                /* The portal's tokens where they exist - inside the app - and
                   a literal fallback for the public site, which does not load
                   corelab.css. Hard-coded white here put white cards on a dark
                   page on every phone in dark mode. */
                .mv-slot-card {
                    cursor: pointer;
                    border: 1px solid var(--mv-border, #dee2e6);
                    border-radius: 0.5rem;
                    padding: 0.75rem 1rem;
                    margin-bottom: 0.5rem;
                    display: flex;
                    align-items: flex-start;
                    gap: 0.75rem;
                    background: var(--mv-card-bg, #fff);
                    color: var(--mv-ink-text, #3a3330);
                    transition: border-color 0.15s, background 0.15s;
                    width: 100%;
                }
                .mv-slot-card .mv-slot-name { color: var(--mv-ink-text, #3a3330); }
                .mv-slot-card .mv-slot-meta { color: var(--mv-muted, #6c757d); }
                .mv-slot-card:hover { border-color: #9ABACD; }
                .mv-slot-card.mv-slot-selected {
                    border-color: #9ABACD;
                    background: var(--mv-active-fill, #e8f3f8);
                    color: var(--mv-accent-fg, #3a3330);
                }
                .mv-slot-card.mv-slot-selected .mv-slot-name,
                .mv-slot-card.mv-slot-selected .mv-slot-meta {
                    color: inherit;
                }
                /* The public form has no tokens to inherit, so dark mode is
                   spelled out for it rather than left to a white default. */
                /* Guarded, so an explicit light choice beats a dark phone
                   here as it does everywhere else, and repeated for the
                   switch so this page follows it too. Every selector in both
                   copies is prefixed - a rule left unprefixed would escape
                   its media query and paint cream text on the white card. */
                @media (prefers-color-scheme: dark) {
                    :root:not([data-theme="light"]) .mv-slot-card {
                        background: var(--mv-card-bg, #241c18);
                        color: var(--mv-ink-text, #F2EAE3);
                        border-color: var(--mv-border, #3b302a);
                    }
                    :root:not([data-theme="light"]) .mv-slot-card .mv-slot-name { color: var(--mv-ink-text, #F2EAE3); }
                    :root:not([data-theme="light"]) .mv-slot-card .mv-slot-meta { color: var(--mv-muted, #b3a49a); }
                }
                :root[data-theme="dark"] .mv-slot-card {
                    background: var(--mv-card-bg, #241c18);
                    color: var(--mv-ink-text, #F2EAE3);
                    border-color: var(--mv-border, #3b302a);
                }
                :root[data-theme="dark"] .mv-slot-card .mv-slot-name { color: var(--mv-ink-text, #F2EAE3); }
                :root[data-theme="dark"] .mv-slot-card .mv-slot-meta { color: var(--mv-muted, #b3a49a); }
                .mv-slot-card input[type="radio"] { margin-top: 0.2rem; flex-shrink: 0; }
                .mv-date-filters {
                    display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px;
                }
                .mv-date-pill {
                    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.04em;
                    padding: 4px 12px; border-radius: 20px;
                    border: 1.5px solid #c8bfb8; background: #fff; color: #357393;
                    cursor: pointer; transition: background 0.15s, border-color 0.15s, color 0.15s;
                    white-space: nowrap;
                }
                .mv-date-pill:hover { border-color: #9ABACD; }
                .mv-date-pill.mv-active { background: #7A6458; border-color: #7A6458; color: #fff; }
            </style>

            <!-- ── Success state ───────────────────────────────────────── -->
            <t t-if="success">
                <div class="text-center mb-4 mt-2">
                    <div style="font-size:2rem;margin-bottom:0.75rem;">✓</div>
                    <h5 class="fw-semibold mb-2">
                        <t t-if="_lang == 'en_US'">Request received</t>
                        <t t-elif="_lang == 'ca_ES'">Sol·licitud rebuda</t>
                        <t t-else="">Solicitud recibida</t>
                    </h5>
                    <p class="text-muted small mb-0">
                        <t t-if="_lang == 'en_US'">The studio will confirm your class shortly. We have emailed you a copy of your request.</t>
                        <t t-elif="_lang == 'ca_ES'">L'estudi et confirmarà la classe ben aviat. T'hem enviat una còpia de la teva sol·licitud per correu.</t>
                        <t t-else="">El estudio te confirmará la clase en breve. Te hemos enviado una copia de tu solicitud por correo.</t>
                    </p>
                </div>
                <!-- Not "submit another request": there is one trial per
                     person, so inviting a second one offered something that
                     would be refused. The page ends by looking forward to
                     the class and handing them back to the site. -->
                <!-- The token, not the literal. #7a6458 is the light theme's
                     own text colour - it added nothing there and came out at
                     3.00:1 on a dark phone, while every other line on this
                     page read at 10.88:1. -->
                <p class="text-center fw-semibold mt-3 mb-2" style="color:var(--mv-ink-text, #7a6458);">
                    <t t-if="_lang == 'en_US'">We can’t wait to meet you.</t>
                    <t t-elif="_lang == 'ca_ES'">Tenim moltes ganes de conèixer-te.</t>
                    <t t-else="">¡Estamos deseando conocerte!</t>
                </p>
                <div class="text-center mt-2">
                    <!-- Opened from inside the app: back means Home, not the
                         marketing site. Sending a student there logs them out
                         of the flow they were in and leaves them hunting for
                         the app icon again. -->
                    <t t-if="source == 'app'">
                        <a href="/my/home" class="btn btn-link btn-sm text-muted">
                            <t t-if="_lang == 'en_US'">Back to home</t>
                            <t t-elif="_lang == 'ca_ES'">Tornar a l'inici</t>
                            <t t-else="">Volver al inicio</t>
                        </a>
                    </t>
                    <t t-else="">
                        <a href="https://corelabstudio.es" class="btn btn-link btn-sm text-muted">
                            <t t-if="_lang == 'en_US'">Back to corelabstudio.es</t>
                            <t t-elif="_lang == 'ca_ES'">Tornar a corelabstudio.es</t>
                            <t t-else="">Volver a corelabstudio.es</t>
                        </a>
                    </t>
                </div>
            </t>

            <!-- ── Form state ───────────────────────────────────────────── -->
            <t t-else="">
                <div class="text-center mb-4 mt-1">
                    <h5 class="fw-semibold mb-1">
                        <t t-if="_lang == 'en_US'">Request a trial class</t>
                        <t t-elif="_lang == 'ca_ES'">Sol·licitar una classe de prova</t>
                        <t t-else="">Solicitar clase de prueba</t>
                    </h5>
                    <p class="text-muted small mb-0">
                        <t t-if="_lang == 'en_US'">Choose your class type and fill in the form.</t>
                        <t t-elif="_lang == 'ca_ES'">Tria el tipus de classe i omple el formulari.</t>
                        <t t-else="">Elige el tipo de clase y rellena el formulario.</t>
                    </p>
                </div>

                <t t-if="error">
                    <div class="alert alert-danger small mb-3" role="alert">
                        <t t-esc="error"/>
                    </div>
                </t>

                <form method="post" action="/trial/submit" class="mv-trial-form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <!-- Which entry point this was. Stamped here rather than
                         inferred from the session: somebody can be signed in
                         and still be reading the public site. -->
                    <input type="hidden" name="source" t-att-value="source or 'website'"/>

                    <!-- ── Name ───────────────────────────────────────────── -->
                    <div class="mb-3">
                        <label for="trial_name" class="form-label">
                            <t t-if="_lang == 'en_US'">Name</t>
                            <t t-elif="_lang == 'ca_ES'">Nom</t>
                            <t t-else="">Nombre</t>
                            <span class="text-danger">*</span>
                        </label>
                        <input type="text" id="trial_name" name="name" class="form-control"
                               required="required" autocomplete="name"
                               t-att-value="form_values.get('name', '')"/>
                    </div>

                    <!-- ── Email ──────────────────────────────────────────── -->
                    <div class="mb-3">
                        <label for="trial_email" class="form-label">
                            <t t-if="_lang == 'en_US'">Email</t>
                            <t t-elif="_lang == 'ca_ES'">Correu electrònic</t>
                            <t t-else="">Correo electrónico</t>
                            <span class="text-danger">*</span>
                        </label>
                        <input type="email" id="trial_email" name="email" class="form-control"
                               required="required" autocomplete="email"
                               t-att-value="form_values.get('email', '')"/>
                    </div>

                    <!-- ── Phone ──────────────────────────────────────────── -->
                    <div class="mb-3">
                        <label for="trial_phone" class="form-label">
                            <t t-if="_lang == 'en_US'">Phone <span class="text-muted small">(optional)</span></t>
                            <t t-elif="_lang == 'ca_ES'">Telèfon <span class="text-muted small">(opcional)</span></t>
                            <t t-else="">Teléfono <span class="text-muted small">(opcional)</span></t>
                        </label>
                        <input type="tel" id="trial_phone" name="phone" class="form-control"
                               autocomplete="tel"
                               t-att-value="form_values.get('phone', '')"/>
                    </div>

                    <!-- ── When ───────────────────────────────────────────────
                         Date and period come first now. They used to come
                         last, after the student had already chosen a class
                         from the catalogue of everything the studio runs -
                         so the class they picked might not run on their day
                         at all, and a class the studio had cancelled for
                         that day was still offered. Asking when first means
                         the next question can be answered from the
                         timetable instead of the catalogue. -->
                    <div class="mb-3">
                        <label class="form-label" for="trial_preferred_date">
                            <t t-if="_lang == 'en_US'">Preferred date</t>
                            <t t-elif="_lang == 'ca_ES'">Data preferida</t>
                            <t t-else="">Fecha preferida</t>
                            <span class="text-danger">*</span>
                        </label>
                        <input type="date" id="trial_preferred_date" name="preferred_date"
                               class="form-control" required="required"
                               t-att-min="today_iso"
                               t-att-data-open-dows="','.join(str(d) for d in open_dows)"
                               t-att-value="form_values.get('preferred_date', '')"/>
                        <!-- Named rather than left to be discovered: a date
                             input cannot grey out weekends, so the only other
                             way to learn the studio is shut on Sunday is to
                             pick it and be told. -->
                        <div class="form-text" t-if="open_days_label">
                            <t t-if="_lang == 'en_US'">Classes run <t t-out="open_days_label"/>.</t>
                            <t t-elif="_lang == 'ca_ES'">Fem classes de <t t-out="open_days_label"/>.</t>
                            <t t-else="">Hay clases de <t t-out="open_days_label"/>.</t>
                        </div>
                        <div class="invalid-feedback d-block d-none" id="mv-date-closed">
                            <t t-if="_lang == 'en_US'">The studio is closed that day.</t>
                            <t t-elif="_lang == 'ca_ES'">L'estudi està tancat aquell dia.</t>
                            <t t-else="">El estudio está cerrado ese día.</t>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            <t t-if="_lang == 'en_US'">Morning or evening?</t>
                            <t t-elif="_lang == 'ca_ES'">Matí o tarda?</t>
                            <t t-else="">¿Mañana o tarde?</t>
                            <span class="text-danger">*</span>
                        </label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="preferred_period"
                                       id="pp_morning" value="morning" required="required"
                                       t-att-checked="'checked' if form_values.get('preferred_period') == 'morning' else None"/>
                                <label class="form-check-label" for="pp_morning">
                                    <t t-if="_lang == 'en_US'">Morning</t>
                                    <t t-elif="_lang == 'ca_ES'">Matí</t>
                                    <t t-else="">Mañana</t>
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="preferred_period"
                                       id="pp_evening" value="evening"
                                       t-att-checked="'checked' if form_values.get('preferred_period') == 'evening' else None"/>
                                <label class="form-check-label" for="pp_evening">
                                    <t t-if="_lang == 'en_US'">Evening</t>
                                    <t t-elif="_lang == 'ca_ES'">Tarda</t>
                                    <t t-else="">Tarde</t>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- ── Which class ────────────────────────────────────────
                         Filled from /trial/classes the moment the date or the
                         period changes, so this is the timetable as it stands
                         and not a catalogue: a class the studio cancelled for
                         that day is simply not in the answer, and cannot be
                         chosen. Empty until a date and a period are set,
                         because until then there is no honest list to show. -->
                    <div class="mb-3" id="mv-class-pick">
                        <label class="form-label">
                            <t t-if="_lang == 'en_US'">Which class?</t>
                            <t t-elif="_lang == 'ca_ES'">Quina classe?</t>
                            <t t-else="">¿Qué clase?</t>
                            <span class="text-danger">*</span>
                        </label>
                        <div id="mv-class-hint" class="form-text">
                            <t t-if="_lang == 'en_US'">Pick a date and a time of day to see what runs.</t>
                            <t t-elif="_lang == 'ca_ES'">Tria un dia i un moment del dia per veure què hi ha.</t>
                            <t t-else="">Elige un día y un momento del día para ver qué hay.</t>
                        </div>
                        <div id="mv-class-loading" class="form-text d-none">
                            <t t-if="_lang == 'en_US'">Looking at the timetable…</t>
                            <t t-elif="_lang == 'ca_ES'">Consultant l'horari…</t>
                            <t t-else="">Consultando el horario…</t>
                        </div>
                        <!-- Said plainly rather than left as an empty box: a
                             day with nothing on it looks identical to a form
                             that has not loaded. -->
                        <div id="mv-class-empty" class="form-text text-danger d-none">
                            <t t-if="_lang == 'en_US'">No classes that day at that time. Try another day or the other half of the day.</t>
                            <t t-elif="_lang == 'ca_ES'">No hi ha classes aquell dia en aquell moment. Prova un altre dia o l'altra meitat del dia.</t>
                            <t t-else="">No hay clases ese día a esa hora. Prueba otro día o la otra mitad del día.</t>
                        </div>
                        <div id="mv-class-list" class="mv-slot-grid"
                             t-att-data-free-word="'places free' if _lang == 'en_US' else ('lliures' if _lang == 'ca_ES' else 'libres')"/>
                    </div>

                    <!-- Carried, not shown. The discipline and the class type
                         used to be things the student picked; now they are
                         read off whichever class they chose, so a Reformer
                         request cannot arrive carrying a Barre class type. -->
                    <input type="hidden" name="class_interest" id="mv-class-interest"
                           t-att-value="form_values.get('class_interest', '')"/>
                    <input type="hidden" name="class_type_id" id="mv-class-type"
                           t-att-value="form_values.get('class_type_id', '')"/>
                    <input type="hidden" name="occurrence_id" id="mv-occurrence"
                           t-att-value="form_values.get('occurrence_id', '')"/>

                    <!-- Asked only once the chosen class turns out to be a
                         Reformer one. It used to hang off the discipline
                         radio, which no longer exists. -->
                    <div id="mv-reformer-intake" class="mv-trial-conditional d-none mb-3">
                        <label class="form-label">
                            <t t-if="_lang == 'en_US'">Have you done Reformer before?</t>
                            <t t-elif="_lang == 'ca_ES'">Has fet Reformer abans?</t>
                            <t t-else="">¿Has hecho Reformer antes?</t>
                            <span class="text-danger">*</span>
                        </label>
                        <div class="d-flex gap-3 mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="reformer_is_first_time"
                                       id="rf_first_yes" value="yes"
                                       t-att-checked="'checked' if form_values.get('reformer_is_first_time') == 'yes' else None"/>
                                <label class="form-check-label" for="rf_first_yes">
                                    <t t-if="_lang == 'en_US'">No, it would be my first time</t>
                                    <t t-elif="_lang == 'ca_ES'">No, seria el meu primer cop</t>
                                    <t t-else="">No, sería mi primera vez</t>
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="reformer_is_first_time"
                                       id="rf_first_no" value="no"
                                       t-att-checked="'checked' if form_values.get('reformer_is_first_time') == 'no' else None"/>
                                <label class="form-check-label" for="rf_first_no">
                                    <t t-if="_lang == 'en_US'">Yes, I have</t>
                                    <t t-elif="_lang == 'ca_ES'">Sí, ja n'he fet</t>
                                    <t t-else="">Sí, ya he hecho</t>
                                </label>
                            </div>
                        </div>
                        <!-- Only worth asking of somebody who has done it before. -->
                        <div id="mv-reformer-years" class="d-none">
                            <label class="form-label" for="rf_years">
                                <t t-if="_lang == 'en_US'">How much experience do you have?</t>
                                <t t-elif="_lang == 'ca_ES'">Quanta experiència tens?</t>
                                <t t-else="">¿Cuánta experiencia tienes?</t>
                            </label>
                            <input type="text" id="rf_years" name="reformer_years_experience"
                                   class="form-control"
                                   t-att-placeholder="'e.g. 2 years, on and off' if _lang == 'en_US' else ('p. ex. 2 anys, amb pauses' if _lang == 'ca_ES' else 'p. ej. 2 años, con pausas')"
                                   t-att-value="form_values.get('reformer_years_experience', '')"/>
                        </div>
                    </div>
                    <!-- ── Submit ─────────────────────────────────────── -->
                    <div class="d-grid mt-2">
                        <button type="submit" id="mv-trial-submit" class="btn btn-primary" disabled="disabled"
                                t-att-data-sending="'Sending\u2026' if _lang == 'en_US' else ('Enviant\u2026' if _lang == 'ca_ES' else 'Enviando\u2026')">
                            <t t-if="_lang == 'en_US'">Submit request</t>
                            <t t-elif="_lang == 'ca_ES'">Envia la sol·licitud</t>
                            <t t-else="">Enviar solicitud</t>
                        </button>
                    </div>
                    <!-- Only for a visitor who is not signed in. Somebody
                         filling this in from inside the app already has an
                         account and is using it. -->
                    <p t-if="request.env.user._is_public()" class="text-center small text-muted mt-3 mb-0">
                        <t t-if="_lang == 'en_US'">Already have an account? <a href="/web/login" class="text-decoration-none">Log in</a></t>
                        <t t-elif="_lang == 'ca_ES'">Ja tens compte? <a href="/web/login" class="text-decoration-none">Inicia sessió</a></t>
                        <t t-else="">¿Ya tienes cuenta? <a href="/web/login" class="text-decoration-none">Inicia sesión</a></t>
                    </p>
                </form>

                <script>
                (function () {
                    var dateInput  = document.getElementById('trial_preferred_date');
                    var listBox    = document.getElementById('mv-class-list');
                    var hintBox    = document.getElementById('mv-class-hint');
                    var loadBox    = document.getElementById('mv-class-loading');
                    var emptyBox   = document.getElementById('mv-class-empty');
                    var fInterest  = document.getElementById('mv-class-interest');
                    var fClassType = document.getElementById('mv-class-type');
                    var fOccurrence= document.getElementById('mv-occurrence');
                    var rfIntake   = document.getElementById('mv-reformer-intake');
                    var rfYears    = document.getElementById('mv-reformer-years');
                    var submitBtn  = document.getElementById('mv-trial-submit');
                    var closedMsg  = document.getElementById('mv-date-closed');

                    function show(el, on) { if (el) el.classList.toggle('d-none', !on); }

                    // The studio is shut some days. A date input cannot grey
                    // those out, so this is the only warning there is.
                    function dateIsOpen() {
                        if (!dateInput || !dateInput.value) return true;
                        var raw = dateInput.getAttribute('data-open-dows') || '';
                        if (!raw) return true;
                        var allowed = raw.split(',').filter(function (s) { return s !== ''; });
                        if (!allowed.length) return true;
                        var parts = dateInput.value.split('-');
                        var d = new Date(parts[0], parts[1] - 1, parts[2]);
                        var dow = (d.getDay() + 6) % 7;   // Monday = 0, as Python counts
                        return allowed.indexOf(String(dow)) !== -1;
                    }

                    function chosenPeriod() {
                        var p = document.querySelector('input[name="preferred_period"]:checked');
                        return p ? p.value : '';
                    }

                    function clearChoice() {
                        if (fInterest)   fInterest.value = '';
                        if (fClassType)  fClassType.value = '';
                        if (fOccurrence) fOccurrence.value = '';
                        show(rfIntake, false);
                        show(rfYears, false);
                        document.querySelectorAll('input[name="reformer_is_first_time"]').forEach(
                            function (r) { r.checked = false; });
                        updateSubmit();
                    }

                    // A Reformer class asks one more question; a Barre class
                    // does not. Read off the class rather than off a
                    // discipline the student picked, because they no longer
                    // pick one.
                    function onPick(slot) {
                        if (fInterest)   fInterest.value = slot.discipline || '';
                        if (fClassType)  fClassType.value = slot.class_type_id || '';
                        if (fOccurrence) fOccurrence.value = slot.id || '';
                        var isReformer = (slot.discipline === 'reformer');
                        show(rfIntake, isReformer);
                        if (!isReformer) {
                            show(rfYears, false);
                            document.querySelectorAll('input[name="reformer_is_first_time"]').forEach(
                                function (r) { r.checked = false; });
                        }
                        updateSubmit();
                    }

                    function render(slots) {
                        listBox.innerHTML = '';
                        show(emptyBox, slots.length === 0);
                        slots.forEach(function (slot) {
                            var label = document.createElement('label');
                            label.className = 'mv-slot-card';
                            var radio = document.createElement('input');
                            radio.type = 'radio';
                            radio.name = 'mv_slot';
                            radio.value = slot.id;
                            radio.className = 'mv-slot-radio';
                            radio.addEventListener('change', function () {
                                document.querySelectorAll('#mv-class-list .mv-slot-card')
                                    .forEach(function (c) { c.classList.remove('mv-slot-card--on'); });
                                label.classList.add('mv-slot-card--on');
                                onPick(slot);
                            });
                            var body = document.createElement('span');
                            body.className = 'mv-slot-body';
                            var title = document.createElement('span');
                            title.className = 'mv-slot-title';
                            title.textContent = slot.time + '  ' + slot.name;
                            var meta = document.createElement('span');
                            meta.className = 'small mv-slot-meta';
                            var bits = [];
                            if (slot.room) bits.push(slot.room);
                            if (slot.duration) bits.push(slot.duration + ' min');
                            if (slot.free !== null &amp;&amp; slot.free !== undefined) {
                                bits.push(slot.free + ' ' + (listBox.dataset.freeWord || ''));
                            }
                            meta.textContent = bits.join(' · ');
                            body.appendChild(title);
                            body.appendChild(meta);
                            label.appendChild(radio);
                            label.appendChild(body);
                            listBox.appendChild(label);
                        });
                    }

                    var inFlight = null;
                    function loadClasses() {
                        clearChoice();
                        listBox.innerHTML = '';
                        show(emptyBox, false);
                        var day = dateInput ? dateInput.value : '';
                        var period = chosenPeriod();
                        var open = dateIsOpen();
                        show(closedMsg, !!day &amp;&amp; !open);
                        if (!day || !period || !open) {
                            show(hintBox, true);
                            show(loadBox, false);
                            return;
                        }
                        show(hintBox, false);
                        show(loadBox, true);
                        var token = {};
                        inFlight = token;
                        fetch('/trial/classes?date=' + encodeURIComponent(day)
                              + '&amp;period=' + encodeURIComponent(period),
                              { headers: { 'Accept': 'application/json' } })
                            .then(function (r) { return r.json(); })
                            .then(function (data) {
                                // A slower earlier answer must not overwrite a
                                // newer one: the student can change the date
                                // twice before the first reply lands.
                                if (inFlight !== token) return;
                                show(loadBox, false);
                                render((data &amp;&amp; data.slots) || []);
                            })
                            .catch(function () {
                                if (inFlight !== token) return;
                                show(loadBox, false);
                                show(emptyBox, true);
                            });
                    }

                    function updateSubmit() {
                        if (!submitBtn) return;
                        var ok = !!(fOccurrence &amp;&amp; fOccurrence.value
                                    &amp;&amp; dateInput &amp;&amp; dateInput.value
                                    &amp;&amp; chosenPeriod() &amp;&amp; dateIsOpen());
                        if (ok &amp;&amp; fInterest &amp;&amp; fInterest.value === 'reformer') {
                            ok = !!document.querySelector('input[name="reformer_is_first_time"]:checked');
                        }
                        submitBtn.disabled = !ok;
                    }

                    function showYears() {
                        var been = document.querySelector('input[name="reformer_is_first_time"]:checked');
                        show(rfYears, !!been &amp;&amp; been.value === 'no');
                        updateSubmit();
                    }

                    if (dateInput) dateInput.addEventListener('change', loadClasses);
                    document.querySelectorAll('input[name="preferred_period"]').forEach(
                        function (r) { r.addEventListener('change', loadClasses); });
                    document.querySelectorAll('input[name="reformer_is_first_time"]').forEach(
                        function (r) { r.addEventListener('change', showYears); });

                    // Coming back from a validation error: the date and period
                    // survive on the form, so reload the list rather than
                    // leaving the student looking at an empty box.
                    if (dateInput &amp;&amp; dateInput.value &amp;&amp; chosenPeriod()) {
                        loadClasses();
                    } else {
                        updateSubmit();
                    }
                })();
                </script>
            </t>

        </t>
    </template>

</odoo>
