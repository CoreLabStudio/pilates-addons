<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ── Cancelling a request ─────────────────────────────────────────
       A dialog, not a status on the statusbar: the student is told what the
       studio says here, by email and in the app, so there has to be somewhere
       to say it. -->
  <record id="view_fitness_trial_decline_wizard_form" model="ir.ui.view">
    <field name="name">fitness.trial.decline.wizard.form</field>
    <field name="model">fitness.trial.decline.wizard</field>
    <field name="arch" type="xml">
      <form string="Cancel this request">
        <field name="request_id" invisible="1"/>
        <div class="alert alert-info" role="status">
          This is sent to <field name="student_name" nolabel="1" readonly="1"
                                 class="fw-bold d-inline"/> by email and in the
          app. Their free class is not used up - they can ask again.
        </div>
        <group>
          <field name="reason" nolabel="1" colspan="2"
                 placeholder="Optional - e.g. We have no Reformer space that week, please ask again for the following one."/>
        </group>
        <footer>
          <button name="action_confirm" type="object" string="Cancel the request"
                  class="btn-primary"/>
          <button string="Keep it" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="view_fitness_trial_request_list" model="ir.ui.view">
    <field name="name">fitness.trial.request.list</field>
    <field name="model">fitness.trial.request</field>
    <field name="arch" type="xml">
      <list string="Trial Requests" default_order="create_date desc"
            decoration-info="status == 'pending'"
            decoration-warning="status == 'contacted'"
            decoration-success="status == 'scheduled'"
            decoration-danger="status == 'declined'">
        <field name="create_date" string="Received" optional="show"/>
        <field name="source" widget="badge"
               decoration-info="source == 'website'"
               decoration-success="source == 'app'"/>
        <field name="name" string="Name"/>
        <field name="email"/>
        <field name="phone" optional="show"/>
        <field name="class_interest" widget="badge"
               decoration-primary="class_interest == 'reformer'"
               decoration-info="class_interest == 'barre'"/>
        <field name="preferred_time_notes" string="Preferred Time" optional="show"/>
        <field name="status" widget="badge"/>
        <!-- Two open asks from one person is a decision for the studio, not a
             thing to merge quietly. Shown on the list so it is noticed before
             one of them gets booked. -->
        <field name="other_open_count" string="Dupes" optional="show"
               widget="badge" decoration-danger="other_open_count > 0"
               invisible="other_open_count == 0"/>
        <!-- Asking again after her trial is finished. Not a duplicate - the
             column above only counts requests nobody has answered yet - and
             not an error either, since she may want to buy a class. Shown
             because approving it WILL be refused, and finding that out by
             clicking Approve is what made it read as a bug. -->
        <field name="trial_already_used" string="Trial Used" optional="show"
               widget="boolean_toggle" readonly="1"
               invisible="not trial_already_used"/>
        <field name="partner_id" string="Student" optional="show"/>
        <field name="occurrence_id" optional="show"/>
        <field name="scheduled_datetime" string="Scheduled" optional="show"/>
        <field name="confirmation_email_sent" string="Email Sent" optional="show"/>
        <field name="lang" optional="hide"/>
      </list>
    </field>
  </record>

  <record id="view_fitness_trial_request_form" model="ir.ui.view">
    <field name="name">fitness.trial.request.form</field>
    <field name="model">fitness.trial.request</field>
    <field name="arch" type="xml">
      <form string="Trial Class Request">
        <header>
          <!-- Approving is what actually books the student. It needs a slot,
               which is why the button is hidden until one is chosen rather
               than failing with an error after the click. -->
          <button name="action_approve_and_book"
                  string="Approve &amp; Book"
                  type="object"
                  class="btn-primary"
                  invisible="status in ('scheduled', 'declined') or not occurrence_id"/>
          <button name="action_view_candidate_slots" type="object"
                  string="See slots and capacity"
                  invisible="status in ('scheduled', 'declined')"/>
          <!-- Cancelling asks why first. Hidden once the request is finished
               either way - a scheduled one is cancelled from the booking, so
               the seat is released and the credit comes back. -->
          <button name="action_decline" type="object"
                  string="Cancel request"
                  invisible="status in ('scheduled', 'declined')"/>
          <button name="action_send_confirmation_email"
                  string="Send Confirmation Email"
                  type="object"
                  class="btn-primary"
                  invisible="status != 'scheduled' or confirmation_email_sent"/>
          <button name="action_send_confirmation_email"
                  string="Resend Confirmation"
                  type="object"
                  invisible="status != 'scheduled' or not confirmation_email_sent"/>
          <field name="status" widget="statusbar"
                 statusbar_visible="pending,contacted,scheduled,declined"/>
        </header>
        <sheet>
          <!-- Says it once, at the top, before any of the scheduling below is
               acted on. -->
          <div class="alert alert-warning d-flex align-items-center gap-2"
               role="alert" invisible="other_open_count == 0">
            <field name="duplicate_warning" nolabel="1" readonly="1"
                   class="flex-grow-1 mb-0"/>
            <button name="action_view_other_open" type="object"
                    string="Show them" class="btn btn-sm btn-warning"/>
          </div>
          <!-- Separate banner rather than folded into the one above: they
               are different facts with different answers. "Two people are
               waiting under this name" means pick one. "She has already had
               her trial" means this one cannot be approved at all, and the
               studio should be told that before it tries. -->
          <div class="alert alert-danger d-flex align-items-center gap-2"
               role="alert" invisible="not trial_already_used">
            <field name="trial_used_warning" nolabel="1" readonly="1"
                   class="flex-grow-1 mb-0"/>
          </div>
          <field name="trial_already_used" invisible="1"/>
          <field name="other_open_count" invisible="1"/>
          <field name="other_open_ids" invisible="1"/>
          <div class="oe_title">
            <label for="name"/>
            <h1><field name="name" placeholder="Requester name"/></h1>
          </div>
          <group>
            <group string="Contact">
              <field name="email"/>
              <field name="phone"/>
              <field name="lang" string="Language"/>
            </group>
            <group string="Class Interest">
              <field name="class_interest" widget="radio"/>
              <field name="class_type_id" string="Class Requested"
                     options="{'no_create': True}"
                     domain="[('classroom_type', '=', class_interest)]"/>
              <field name="preferred_date" string="Preferred Date"/>
              <field name="preferred_period" string="Morning / Evening"/>
            </group>
          </group>
          <group string="Scheduling">
            <group>
              <!-- Read-only: the header statusbar already shows it, and an
                   editable copy here was a second way to cancel that skipped
                   the reason and the notification. -->
              <field name="status" string="Status" readonly="1"/>
              <field name="source" string="Came from" readonly="1"/>
              <!-- Filled in from the request's own email on submit, and created
                   from its name/email/phone at approval if the person is new.
                   It was blank on every website request, and the studio was
                   retyping details the form had already collected. -->
              <field name="partner_id" options="{'no_create': True}"/>
              <!-- The slot is what approval books into, so it has to be
                   settable for every discipline. It was hidden unless the
                   request was for Barre, which meant a Reformer request could
                   never be given a slot - and the Approve button, which needs
                   one, could never appear. -->
              <!-- Scoped to classes that can actually be booked for THIS
                   request: the right discipline, still to come, not cancelled.
                   Unscoped, the list offered a Barre class for a Reformer
                   request, and the approval then failed on the booking's
                   discipline check with a message about subscriptions that
                   said nothing about the real mistake. -->
              <!-- Narrowed to the day and time of day the student asked for,
                   computed in Python so the public form and this picker share
                   one rule. It used to ignore the request entirely and offer
                   every future class nearest-first, which is how two students
                   were approved onto a class six and ten days early. The
                   narrowing lifts itself when nothing runs then, and Show
                   every class lifts it by hand - placing somebody in a fuller
                   class on purpose is a real thing the studio does. -->
              <field name="occurrence_id_domain" invisible="1"/>
              <!-- Otherwise the picker quietly showing everything looks the
                   same as the picker being narrowed, and the studio cannot
                   tell which it is looking at. -->
              <div class="alert alert-warning mb-2" role="alert" colspan="2"
                   invisible="not preferred_date or suggested_slot_ids">
                Nothing runs on the day they asked for, so every class is being offered.
              </div>
              <field name="occurrence_id" options="{'no_create': True}"
                     domain="occurrence_id_domain"/>
              <field name="show_all_slots"
                     invisible="not preferred_date or not suggested_slot_ids"/>
              <field name="suggested_slot_ids" invisible="1"/>
              <!-- How full the chosen slot is, so placing somebody is an
                   informed decision rather than a guess followed by a
                   capacity error on save. -->
              <field name="occurrence_fill" string="How full" readonly="1"
                     invisible="not occurrence_id"/>
              <!-- Comes from the Class Slot above. Two places to say when
                   the class is would eventually disagree, and the slot is the
                   one that actually gets booked. -->
              <field name="scheduled_datetime" string="Scheduled Date/Time"
                     readonly="1"/>
              <field name="confirmation_email_sent" string="Confirmation Email Sent" readonly="1"/>
              <field name="confirmation_email_sent_date" string="Confirmation Sent On"
                     readonly="1" invisible="not confirmation_email_sent"/>
              <field name="create_date" string="Request Received" readonly="1"/>
              <!-- Kept on the record so the next person to open it can see
                   what was decided and why, not just that it was declined. -->
              <field name="decline_reason" string="Cancelled because"
                     readonly="1" invisible="not decline_reason"/>
            </group>
          </group>
          <!-- Reformer intake fields — only relevant when class_interest == 'reformer' -->
          <group string="Reformer Intake" invisible="class_interest != 'reformer'">
            <group>
              <field name="reformer_is_first_time" string="First time with Reformer?"/>
              <field name="reformer_years_experience" string="Years of Experience"/>
            </group>
          </group>
          <group string="Preferred Day / Time (from requester)">
            <field name="preferred_time_notes" nolabel="1"
                   placeholder="Free-text note left by the requester about when they'd prefer to come."/>
          </group>
        </sheet>
        <!-- The history, not a conversation: who moved the slot, who changed
             the status, and when. Four requests named a class the student was
             not booked into and nothing on the record said which side had
             moved. -->
        <chatter/>
      </form>
    </field>
  </record>

  <record id="view_fitness_trial_request_search" model="ir.ui.view">
    <field name="name">fitness.trial.request.search</field>
    <field name="model">fitness.trial.request</field>
    <field name="arch" type="xml">
      <search string="Trial Requests">
        <field name="name"/>
        <field name="email"/>
        <separator/>
        <filter string="Barre"    name="barre"    domain="[('class_interest','=','barre')]"/>
        <filter string="Reformer" name="reformer" domain="[('class_interest','=','reformer')]"/>
        <separator/>
        <filter string="Pending"   name="pending"   domain="[('status','=','pending')]"/>
        <filter string="Contacted" name="contacted" domain="[('status','=','contacted')]"/>
        <filter string="Scheduled" name="scheduled" domain="[('status','=','scheduled')]"/>
        <filter string="Cancelled" name="declined"  domain="[('status','=','declined')]"/>
        <group>
          <filter string="Class Type" name="group_class"  context="{'group_by':'class_interest'}"/>
          <filter string="Status"     name="group_status" context="{'group_by':'status'}"/>
        </group>
      </search>
    </field>
  </record>

  <record id="action_fitness_trial_request" model="ir.actions.act_window">
    <field name="name">Trial Requests</field>
    <field name="res_model">fitness.trial.request</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_fitness_trial_request_search"/>
    <field name="context">{'search_default_pending': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No trial requests yet</p>
      <p>Trial class requests submitted through the website will appear here.</p>
    </field>
  </record>

  <record id="action_fitness_trial_pending" model="ir.actions.act_window">
    <field name="name">Pending Review</field>
    <field name="res_model">fitness.trial.request</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_fitness_trial_request_search"/>
    <field name="domain">[('status', '=', 'pending')]</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No pending trial requests</p>
    </field>
  </record>

  <record id="action_fitness_trial_scheduled" model="ir.actions.act_window">
    <field name="name">Scheduled</field>
    <field name="res_model">fitness.trial.request</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_fitness_trial_request_search"/>
    <field name="domain">[('status', '=', 'scheduled')]</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No scheduled trials</p>
    </field>
  </record>

  <record id="action_fitness_trial_barre" model="ir.actions.act_window">
    <field name="name">Barre Log</field>
    <field name="res_model">fitness.trial.request</field>
    <field name="view_mode">list,form</field>
    <field name="search_view_id" ref="view_fitness_trial_request_search"/>
    <field name="domain">[('class_interest', '=', 'barre')]</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No barre trial requests</p>
    </field>
  </record>

</odoo>
