<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        "Check your email" page — shown immediately after self-signup.
        The user is NOT logged in at this point.
        Uses web.login_layout so the CoreLab wordmark (from login_override.xml) appears.
    -->
    <template id="signup_verify_email" name="CoreLab — Check Your Email">
        <t t-call="web.login_layout">
            <div class="text-center mb-4 mt-2">
                <h5 class="fw-semibold mb-2">Check your email</h5>
                <p class="text-muted small mb-0">
                    We sent a verification link to
                    <strong t-esc="email or 'your email address'"/>.
                </p>
            </div>
            <div class="alert alert-info small mb-3" role="status">
                Click the link in the email to activate your account and access the studio portal.
                The link is valid for 6 days.
            </div>
            <p class="text-center small text-muted mt-3 mb-0">
                Already verified?
                <a t-attf-href="/web/login?login={{ email }}" class="text-decoration-none">Sign in</a>
            </p>
            <p class="text-center small text-muted mt-2">
                Didn't receive it? Check your spam folder, or
                <a href="/web/signup" class="text-decoration-none">sign up again</a>
                with the same email to resend.
            </p>
        </t>
    </template>

    <!--
        Verification link is invalid or expired.
    -->
    <template id="verify_email_failed" name="CoreLab — Verification Failed">
        <t t-call="web.login_layout">
            <div class="text-center mb-4 mt-2">
                <h5 class="fw-semibold mb-2">Link expired or invalid</h5>
            </div>
            <div class="alert alert-danger small mb-3" role="alert">
                This verification link is no longer valid. Links expire after 6 days, or become
                invalid once used.
            </div>
            <div class="d-grid gap-2 mt-3">
                <a href="/web/signup" class="btn btn-primary">Create a new account</a>
                <a href="/web/login" class="btn btn-link btn-sm text-muted">Back to sign in</a>
            </div>
        </t>
    </template>

    <!--
        Pending verification — shown when a portal user logs in before verifying.
        The user IS logged in at this point (auth='user').
    -->
    <template id="pending_verification" name="CoreLab — Please Verify Your Email">
        <t t-call="web.login_layout">
            <div class="text-center mb-4 mt-2">
                <h5 class="fw-semibold mb-2">One more step</h5>
                <p class="text-muted small mb-0">
                    Verify your email to access the CoreLab studio portal.
                </p>
            </div>

            <t t-if="resent">
                <div class="alert alert-success small mb-3" role="status">
                    Verification email resent to <strong t-esc="user_email"/>.
                    Check your inbox (and spam folder).
                </div>
            </t>
            <t t-else="">
                <div class="alert alert-info small mb-3" role="status">
                    We sent a verification link to <strong t-esc="user_email"/>.
                    Click it to activate your account.
                </div>
            </t>

            <form method="post" action="/corelab/resend-verification" class="mb-2">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="d-grid">
                    <button type="submit" class="btn btn-primary">Resend verification email</button>
                </div>
            </form>
            <div class="text-center">
                <a href="/web/session/logout?redirect=/web/login" class="btn btn-link btn-sm text-muted">Sign out</a>
            </div>
        </t>
    </template>

</odoo>
