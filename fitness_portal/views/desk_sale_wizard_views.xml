<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_fitness_desk_sale_wizard_form" model="ir.ui.view">
    <field name="name">fitness.desk.sale.wizard.form</field>
    <field name="model">fitness.desk.sale.wizard</field>
    <field name="arch" type="xml">
      <form string="Sell at the desk">

        <!-- The choice first, on its own, before anything else is asked.
             Taking money and giving a class away are different acts and the
             form says so outright: an amount field that could simply be left
             blank would make a gift and a sale look identical on screen. -->
        <group>
          <field name="payment_method" widget="radio" nolabel="1"/>
        </group>

        <div class="alert alert-info mb-3" role="status"
             invisible="payment_method != 'cash'">
          The student pays now, in person. The sale is recorded at the amount
          taken.
        </div>
        <div class="alert alert-warning mb-3" role="status"
             invisible="payment_method != 'free'">
          Nothing is charged and no money is recorded. The classes are given.
        </div>

        <group>
          <group string="Who and what">
            <field name="partner_id" options="{'no_create_edit': True}"/>
            <field name="product_id" options="{'no_create': True}"/>
            <field name="credits_granted" invisible="not product_id"/>
            <field name="validity_days" invisible="not product_id"/>
          </group>

          <group string="Money" invisible="payment_method != 'cash'">
            <field name="currency_id" invisible="1"/>
            <field name="normal_price" invisible="not product_id"/>
            <field name="amount_paid"
                   required="payment_method == 'cash'"/>
          </group>
        </group>

        <group string="Why">
          <field name="reason" nolabel="1"
                 required="payment_method == 'free'"
                 placeholder="Family, an apology, a giveaway, a discount and what for. Required when nothing is charged - it is the only record anyone will have later."/>
        </group>

        <footer>
          <!-- Two buttons rather than one, so the act is named at the moment
               it is committed rather than inferred from a field above. -->
          <button string="Record cash payment" type="object"
                  name="action_create_sale" class="btn-primary"
                  invisible="payment_method != 'cash'"/>
          <button string="Give free credit" type="object"
                  name="action_create_sale" class="btn-warning"
                  invisible="payment_method != 'free'"/>
          <button string="Cancel" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>

  <record id="action_fitness_desk_sale" model="ir.actions.act_window">
    <field name="name">Sell at the desk</field>
    <field name="res_model">fitness.desk.sale.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>

  <menuitem
      id="menu_fitness_desk_sale"
      name="Sell at the desk"
      parent="fitness_core.menu_group_bookings"
      action="action_fitness_desk_sale"
      sequence="35"
      groups="fitness_core.group_fitness_manager"/>

</odoo>
