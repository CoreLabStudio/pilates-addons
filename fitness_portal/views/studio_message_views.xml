<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── fitness.studio.conversation — list + form ── -->

    <record id="view_fitness_studio_conversation_list" model="ir.ui.view">
        <field name="name">fitness.studio.conversation.list</field>
        <field name="model">fitness.studio.conversation</field>
        <field name="arch" type="xml">
            <list string="Studio Conversations" default_order="write_date desc"
                  decoration-info="has_unread" create="0">
                <field name="partner_id" string="From"/>
                <field name="role" string="Role"/>
                <field name="message_count" string="Messages"/>
                <field name="has_unread" string="Needs Reply" widget="boolean"/>
                <field name="last_activity" string="Last Activity"/>
            </list>
        </field>
    </record>

    <record id="view_fitness_studio_conversation_form" model="ir.ui.view">
        <field name="name">fitness.studio.conversation.form</field>
        <field name="model">fitness.studio.conversation</field>
        <field name="arch" type="xml">
            <form string="Conversation" create="0">
                <sheet>
                    <group string="Sender">
                        <field name="partner_id" readonly="1"/>
                        <field name="user_id" readonly="1"/>
                        <field name="role" readonly="1"/>
                        <field name="has_unread" readonly="1" string="Awaiting Reply"/>
                        <field name="last_activity" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Thread">
                            <!-- Read-only message history -->
                            <field name="message_ids" nolabel="1">
                                <list string="Messages"
                                      default_order="create_date asc"
                                      create="0" delete="0">
                                    <field name="create_date" readonly="1" string="Time"/>
                                    <field name="author_name" readonly="1" string="From"/>
                                    <field name="is_admin" readonly="1" string="Admin"/>
                                    <field name="body" readonly="1" string="Message"/>
                                </list>
                            </field>

                            <separator string="Write a Reply"/>
                            <group>
                                <field name="reply_body" nolabel="1"
                                       placeholder="Type your reply here…"/>
                            </group>
                            <div>
                                <button name="action_send_reply" type="object"
                                        string="Send Reply"
                                        class="btn btn-primary"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitness_studio_messages" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">fitness.studio.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_is_admin': True}</field>
    </record>

    <menuitem
        id="menu_fitness_studio_messages"
        name="Messages"
        parent="fitness_core.menu_fitness_root"
        action="action_fitness_studio_messages"
        sequence="50"
        groups="fitness_core.group_fitness_manager"/>

</odoo>
