<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Replace the company logo block with the CoreLab lockup.
    -->
    <template id="mv_login_logo" name="CoreLab Login Logo"
              inherit_id="web.login_layout">
        <xpath expr="//div[hasclass('border-bottom') and hasclass('pb-3')]" position="replace">
            <div class="mv-login-logo">
                <img src="/fitness_core/static/src/img/corelab-logo-header.png"
                     alt="CoreLab"
                     style="height:80px;width:auto;display:block;margin:0 auto;flex-shrink:0;"/>
            </div>
        </xpath>
    </template>

    <!--
        Language switcher injected at the TOP of every login/signup card
        (immediately after the logo, before any form content).
        Sets the mv_lang cookie (read by ir_http.py) and reloads the page.
    -->
    <template id="mv_login_lang_switcher" name="CoreLab Login Language Switcher"
              inherit_id="web.login_layout">
        <xpath expr="//div[hasclass('mv-login-logo')]" position="after">
            <div style="text-align:center;padding:0.6rem 0 0.75rem;margin-bottom:0.25rem;border-bottom:1px solid rgba(0,0,0,.08);">
                <button type="button"
                        style="background:none;border:1px solid #ccc;border-radius:20px;padding:3px 12px;margin:0 3px;font-size:0.7rem;font-weight:600;letter-spacing:0.12em;cursor:pointer;color:#777;"
                        onclick="document.cookie='mv_lang=es_ES;path=/;max-age=31536000';location.reload()">ES</button>
                <button type="button"
                        style="background:none;border:1px solid #ccc;border-radius:20px;padding:3px 12px;margin:0 3px;font-size:0.7rem;font-weight:600;letter-spacing:0.12em;cursor:pointer;color:#777;"
                        onclick="document.cookie='mv_lang=en_US;path=/;max-age=31536000';location.reload()">EN</button>
                <button type="button"
                        style="background:none;border:1px solid #ccc;border-radius:20px;padding:3px 12px;margin:0 3px;font-size:0.7rem;font-weight:600;letter-spacing:0.12em;cursor:pointer;color:#777;"
                        onclick="document.cookie='mv_lang=ca_ES;path=/;max-age=31536000';location.reload()">CA</button>
            </div>
        </xpath>
    </template>

</odoo>
