<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Replace the company logo block with the CoreLab lockup.
    -->
    <template id="mv_login_logo" name="CoreLab Login Logo"
              inherit_id="web.login_layout">
        <xpath expr="//div[hasclass('border-bottom') and hasclass('pb-3')]" position="replace">
            <div class="mv-login-logo">
                <img src="/fitness_core/static/src/img/corelab-logo-header.png"
                     alt="CoreLab"
                     style="height:80px;width:auto;display:block;margin:0 auto;flex-shrink:0;"/>
            </div>
        </xpath>
    </template>

    <!--
        Language switcher injected at the TOP of every login/signup card
        (immediately after the logo, before any form content).
        Sets the mv_lang cookie (read by ir_http.py) and reloads the page.
    -->
    <template id="mv_login_lang_switcher" name="CoreLab Login Language Switcher"
              inherit_id="web.login_layout">
        <xpath expr="//div[hasclass('mv-login-logo')]" position="after">
            <div style="text-align:center;padding:0.6rem 0 0.75rem;margin-bottom:0.25rem;border-bottom:1px solid rgba(0,0,0,.08);">
                <button type="button"
                        class="mv-auth-lang"
                        onclick="document.cookie='mv_lang=es_ES;path=/;max-age=31536000';location.reload()">ES</button>
                <button type="button"
                        class="mv-auth-lang"
                        onclick="document.cookie='mv_lang=en_US;path=/;max-age=31536000';location.reload()">EN</button>
                <button type="button"
                        class="mv-auth-lang"
                        onclick="document.cookie='mv_lang=ca_ES;path=/;max-age=31536000';location.reload()">CA</button>
            </div>
        </xpath>
    </template>


    <!--
        On the LOGIN page, replace the plain "Don't have an account?" link with a
        styled pill button that mirrors the "Already have an account?" pill on the
        signup page.  JS reads the mv_lang cookie to display the right language.
    -->
    <template id="mv_login_signup_pill" name="CoreLab Login Signup Pill"
              inherit_id="auth_signup.login">
        <xpath expr="//a[@t-if='signup_enabled']" position="replace">
            <a t-if="signup_enabled"
               t-attf-href="/web/signup?{{ keep_query() }}"
               class="mv-signup-pill">
                <span class="mv-sp-es" style="display:none">¿No tienes cuenta? Regístrate</span>
                <span class="mv-sp-en" style="display:none">Don't have an account? Sign up</span>
                <span class="mv-sp-ca" style="display:none">No tens compte? Registra't</span>
            </a>
            <script>
            (function(){
              var m=document.cookie.match(/(?:^|; )mv_lang=([^;]*)/);
              var l=m?decodeURIComponent(m[1]):'es_ES';
              var s=l==='en_US'?'.mv-sp-en':l==='ca_ES'?'.mv-sp-ca':'.mv-sp-es';
              document.querySelectorAll(s).forEach(function(e){e.style.display='';});
            }());
            </script>
        </xpath>
    </template>

    <!--
        web.login_layout wraps its card in a bare .container, which the
        centring rules in corelab.css need a hook on.
    -->
    <template id="mv_auth_wrap" name="CoreLab Auth Wrapper"
              inherit_id="web.login_layout">
        <xpath expr="//div[hasclass('container')]" position="attributes">
            <attribute name="class" add="mv-auth-wrap" separator=" "/>
        </xpath>
    </template>

    <!--
        web.login_layout is shared by /web/login, /web/signup,
        /web/reset_password and /trial, so anything added to it lands on all
        four. Two flags keep that straight:

          mv-auth-body   — on every one of them; carries the brand styling.

        Enterprise replaces body_classname with o_home_menu_background in
        web_enterprise.webclient_login, which is why the brand rules keyed on
        Odoo's own bg-100 never fired. Re-setting it after Enterprise (higher
        priority, same insertion point) is what makes them apply again. Its
        class is kept alongside ours rather than dropped, so nothing that
        depends on it changes; corelab.css just overrides the background.
    -->
    <template id="mv_auth_body_class" name="CoreLab Auth Body Class"
              inherit_id="web.login_layout" priority="99">
        <xpath expr="//t[@t-call='web.frontend_layout']/t[last()]" position="after">
            <t t-set="body_classname"
               t-value="'o_home_menu_background mv-auth-body'"/>
        </xpath>
    </template>

    <!--
        Sets the flag the two templates above read. The flag is set per page
        rather than on the shared layout because web.login_layout is used by
        more than the four pages that want a photo: the e-mail verification
        pages, terms and privacy, and Odoo's own TOTP and session-timeout
        screens all render through it. Opting pages in one at a time keeps the
        panel off those.

        The t-call body is evaluated before the layout renders, so a value set
        here is in scope when the panel and the body class are decided.
    -->
</odoo>
