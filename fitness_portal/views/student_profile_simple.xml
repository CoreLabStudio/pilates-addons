<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Simplified student profile form ────────────────────────────────────── -->
    <!--                                                                            -->
    <!-- Standalone (no inherit_id) so it is NOT affected by any inheritance on    -->
    <!-- base.view_users_form. Pinned explicitly via action_view_students           -->
    <!-- in fitness_dashboard.py. priority=32 ensures it never auto-wins over      -->
    <!-- the technical form (priority=16) when no pin is active.                   -->

    <record id="view_student_profile_simple" model="ir.ui.view">
        <field name="name">res.users.form.student.simple</field>
        <field name="model">res.users</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <form string="Student" create="0">
                <sheet>

                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object"
                                name="action_view_student_bookings"
                                icon="fa-calendar-check-o"
                                groups="fitness_core.group_fitness_manager">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Bookings</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_student_credits"
                                icon="fa-ticket"
                                groups="fitness_core.group_fitness_manager">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="fitness_credit_available"/></span>
                                <span class="o_stat_text">Credits</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_student_packages"
                                icon="fa-ticket"
                                groups="fitness_core.group_fitness_manager">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Packages</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_student_subscriptions"
                                icon="fa-rotate-right"
                                groups="fitness_core.group_fitness_manager">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Memberships</span>
                            </div>
                        </button>
                        <!-- What the student filled in about themselves on
                             the portal. Same res.partner record they edit, so
                             this always shows their latest answer. -->
                        <button class="oe_stat_button" type="object"
                                name="action_view_student_details"
                                icon="fa-id-card-o"
                                groups="fitness_core.group_fitness_manager">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Details</span>
                            </div>
                        </button>
                        <button class="oe_stat_button" type="object"
                                name="action_view_student_messages"
                                icon="fa-comments"
                                groups="fitness_core.group_fitness_manager">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Messages</span>
                            </div>
                        </button>
                    </div>

                    <field name="image_1920" widget="image" class="oe_avatar"
                           options="{'preview_image': 'image_128'}" readonly="1"/>
                    <div class="oe_title">
                        <field name="name" readonly="1"/>
                    </div>
                    <!-- Stuck before verification: said here, where the
                         studio is already looking at the person, rather than
                         left to be worked out from an empty shop. The account
                         exists and the password works; only the group that
                         opens the shop is missing. -->
                    <field name="fitness_is_verified_student" invisible="1"/>
                    <field name="share" invisible="1"/>
                    <field name="fitness_is_teacher" invisible="1"/>
                    <!-- An instructor is a portal account without the student
                         group, which is this warning's exact shape - so it
                         fired on all four of them and told the studio they
                         "signed up but never got through email verification".
                         None of them signed up as a student. Raquel made it
                         four; every instructor added makes the list noisier,
                         and a warning that is wrong four times out of four
                         stops being read.
                         She genuinely cannot open the shop - the gate is the
                         student group - but that is a decision, not a stuck
                         signup, and it is made in Settings. -->
                    <div class="alert alert-warning" role="alert"
                         invisible="fitness_is_verified_student or not share
                                    or fitness_is_teacher"
                         groups="fitness_core.group_fitness_manager">
                        <strong>This student cannot open the shop yet.</strong>
                        They signed up but never got through email
                        verification, so they can log in and see nothing to
                        book. Give them access here - they keep the password
                        they already chose and no new email is sent.
                        <div class="mt-2">
                            <button name="action_fitness_verify_student"
                                    type="object" class="btn btn-primary btn-sm"
                                    string="Give shop access"/>
                        </div>
                    </div>

                    <group>
                        <field name="email" string="Email" readonly="1"/>
                        <field name="phone" string="Phone" readonly="1"/>
                        <!-- the one editable field on this form: the rest is a
                             read-only view of what the student manages -->
                        <field name="fitness_is_vip" string="VIP"
                               groups="fitness_core.group_fitness_manager"/>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ── What the student told us about themselves ──────────────────────── -->
    <!--                                                                        -->
    <!-- Opened from the Details button on the student form. These are          -->
    <!-- res.partner fields the student edits from the portal, shown here on    -->
    <!-- the same record - not copied - so the studio sees the current answer.  -->
    <!-- Read-only, like the rest of that form: it is the student's answer.     -->
    <!-- priority=64 keeps it from ever being picked as a default res.users     -->
    <!-- form; it is only ever reached through the button.                      -->

    <record id="view_student_profile_details" model="ir.ui.view">
        <field name="name">res.users.form.student.details</field>
        <field name="model">res.users</field>
        <field name="priority">64</field>
        <field name="arch" type="xml">
            <form string="Details" create="0" edit="0">
                <sheet>
                    <group>
                        <group string="About them">
                            <field name="fitness_day_preference" readonly="1"/>
                            <field name="fitness_music_interest" readonly="1"/>
                            <field name="fitness_favourite_singer" readonly="1"/>
                        </group>
                        <group string="Contact details">
                            <field name="phone" string="Mobile number" readonly="1"/>
                            <field name="fitness_emergency_contact" readonly="1"/>
                        </group>
                    </group>
                    <p class="text-muted">The student fills these in from her profile. Blank means she has not answered yet.</p>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Stored act_window for the student list so the form view pin survives        -->
    <!-- breadcrumb navigation. action_view_students() reads this and adds domain,   -->
    <!-- exactly like action_fitness_teacher_list_server does for teachers.           -->

    <!-- ── Student List ──────────────────────────────────────────────────────── -->
    <!-- Exists so create="false" can be scoped to this action. The action used  -->
    <!-- to fall back to base.view_users_tree, which Settings > Users also uses; -->
    <!-- setting create="false" there would have removed New from that list too. -->
    <!-- priority=32 keeps it from being picked as the default res.users list.   -->

    <record id="view_fitness_student_list" model="ir.ui.view">
        <field name="name">fitness.student.list</field>
        <field name="model">res.users</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <list string="Students" default_order="name asc" create="false">
                <field name="name" string="Student"/>
                <field name="login" string="Login / Email"/>
                <field name="phone" optional="show"/>
                <field name="fitness_is_vip" string="VIP" optional="show"/>
                <!-- Shown by default, and the row is dimmed: somebody stuck
                     before verification has an account that looks entirely
                     normal from here, which is why nobody spotted the four
                     of them. -->
                <field name="fitness_is_verified_student" string="Shop access"
                       optional="show" widget="boolean_toggle" readonly="1"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- VIP is a filter on this list, not a list of its own: opening a VIP
         student has to land on the ordinary student form with its bookings,
         packages and history, which a separate action would not do. -->
    <record id="view_fitness_student_search" model="ir.ui.view">
        <field name="name">fitness.student.search</field>
        <field name="model">res.users</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <search string="Students">
                <field name="name" string="Student"/>
                <field name="login" string="Login / Email"/>
                <filter name="filter_vip" string="VIP"
                        domain="[('fitness_is_vip', '=', True)]"/>
                <!-- The question the studio actually needs to ask after
                     somebody says "I cannot book anything". -->
                <filter name="filter_no_shop_access" string="Cannot open the shop"
                        domain="[('fitness_is_verified_student', '=', False)]"/>
                <separator/>
                <filter name="group_vip" string="VIP"
                        context="{'group_by': 'fitness_is_vip'}"/>
            </search>
        </field>
    </record>

    <record id="action_fitness_student_list" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'sequence': 10, 'view_mode': 'list', 'view_id': ref('fitness_portal.view_fitness_student_list')}),
            (0, 0, {'sequence': 20, 'view_mode': 'form', 'view_id': ref('fitness_portal.view_student_profile_simple')}),
        ]"/>
        <field name="search_view_id" ref="fitness_portal.view_fitness_student_search"/>
    </record>

    <!-- ── Student List, in the Students menu ───────────────────────────────── -->
    <!-- The same list the Students tile on the dashboard opens. Yoleyva could   -->
    <!-- reach it by going Home and clicking the number, and nowhere else: the   -->
    <!-- Instructors section has an Instructor List and the Students section had -->
    <!-- no equivalent.                                                          -->
    <!--                                                                         -->
    <!-- A server action rather than the act_window above, for the same reason   -->
    <!-- the instructor one is: the domain cannot be written in XML. Teachers    -->
    <!-- are portal users too on this database, so share=True alone would list   -->
    <!-- them among the students, and group membership is not searchable in      -->
    <!-- Odoo 19 - hence the SQL, which is what fitness_core's teacher list and  -->
    <!-- the dashboard tile both do.                                             -->
    <record id="action_fitness_student_list_server" model="ir.actions.server">
        <field name="name">Students</field>
        <field name="model_id" ref="base.model_res_users"/>
        <!-- Required, not decorative. _can_execute_action_on_records checks
             group membership when a server action declares groups, and
             otherwise demands WRITE access on the action's model - here
             res.users, which only an Access Rights user has. Without this a
             studio manager is shown the menu and refused the moment she
             clicks it. -->
        <field name="group_ids" eval="[(4, ref('fitness_core.group_fitness_manager'))]"/>
        <field name="state">code</field>
        <field name="code">
teacher_g = env.ref('fitness_core.group_fitness_teacher', raise_if_not_found=False)
if teacher_g:
    env.cr.execute("SELECT uid FROM res_groups_users_rel WHERE gid = %s", [teacher_g.id])
    teacher_ids = [r[0] for r in env.cr.fetchall()]
else:
    teacher_ids = []
domain = [('share', '=', True), ('active', '=', True)]
if teacher_ids:
    domain.append(('id', 'not in', teacher_ids))
base_action = env.ref('fitness_portal.action_fitness_student_list').sudo().read()[0]
base_action['domain'] = domain
action = base_action
        </field>
    </record>

    <!-- Sequence 5: first in the section, as Instructor List is first in its. -->
    <menuitem
        id="menu_fitness_student_list"
        name="Student List"
        parent="fitness_core.menu_group_bookings"
        action="fitness_portal.action_fitness_student_list_server"
        sequence="5"
        groups="fitness_core.group_fitness_manager"
    />


    <!-- ── Credit ledger ────────────────────────────────────────────────────── -->
    <!-- The rows the balance is summed from. Opened by the Credits smart button  -->
    <!-- so an admin reads the same records the portal totals, rather than        -->
    <!-- tallying them by hand off the Packages list.                             -->

    <record id="view_fitness_credit_line_list" model="ir.ui.view">
        <field name="name">fitness.credit.line.list</field>
        <field name="model">sale.order.line</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <list string="Credits" create="false" default_order="fitness_validity_end_date asc">
                <field name="order_id" string="Order"/>
                <field name="product_id" string="Package"/>
                <field name="fitness_original_class_count" string="Purchased" sum="Purchased"/>
                <field name="fitness_classes_used" string="Used" sum="Used"/>
                <field name="fitness_remaining_classes" string="Remaining" sum="Remaining"/>
                <field name="fitness_validity_end_date" string="Valid Until"/>
                <field name="fitness_is_expired" string="Expired"/>
            </list>
        </field>
    </record>

</odoo>
