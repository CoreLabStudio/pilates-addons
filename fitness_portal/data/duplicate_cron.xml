<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- noupdate="1": once the studio has moved this off its nightly
             slot or switched it off, an upgrade must not quietly put it
             back. -->
        <record id="ir_cron_fitness_duplicate_scan" model="ir.cron">
            <field name="name">Fitness: Scan for duplicate contacts</field>
            <field name="model_id" ref="model_fitness_duplicate_candidate"/>
            <field name="state">code</field>
            <field name="code">model._cron_scan_and_notify()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
