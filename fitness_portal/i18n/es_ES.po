#. module: fitness_portal
# ── Terms page — portal_terms
# ────────────────────────────────────────────────
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid "1. Introduction"
msgstr "1. Introducción"

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid ""
"These Terms and Conditions (\"Terms\") govern your use of the CoreLab "
"Pilates studio services, including class bookings, memberships, credit "
"packages, and the online portal provided by Yoleyva Studio (\"we\", \"us\", "
"\"the Studio\"). By booking a class or activating a package you agree to "
"these Terms in full."
msgstr ""
"Estos Términos y Condiciones (\"Términos\") regulan el uso de los servicios "
"del estudio CoreLab Pilates, incluidas las reservas de clases, membresías, "
"bonos de créditos y el portal en línea proporcionado por Yoleyva Studio "
"(\"nosotros\", \"nos\", \"el Estudio\"). Al reservar una clase o activar un "
"bono, aceptas estos Términos en su totalidad."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid "2. Membership &amp; Account"
msgstr "2. Membresía y cuenta"

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid ""
"You must be 16 years of age or older to register independently. Under-16s "
"require written parental or guardian consent."
msgstr ""
"Debes tener 16 años o más para registrarte de forma independiente. Los "
"menores de 16 años necesitan el consentimiento escrito de sus padres o "
"tutores."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid ""
"You are responsible for maintaining the confidentiality of your login "
"credentials. Notify us immediately if you suspect unauthorised access to "
"your account."
msgstr ""
"Eres responsable de mantener la confidencialidad de tus credenciales de "
"acceso. Notifícanos de inmediato si sospechas de un acceso no autorizado a "
"tu cuenta."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid ""
"Accounts are personal and non-transferable. Sharing login details to allow a"
" third party to attend classes is not permitted."
msgstr ""
"Las cuentas son personales e intransferibles. No está permitido compartir "
"las credenciales de acceso para que un tercero asista a las clases."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid "3. Class Booking"
msgstr "3. Reserva de clases"

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid "Classes can be booked through the portal subject to availability."
msgstr ""
"Las clases pueden reservarse a través del portal según disponibilidad."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid ""
"A booking is confirmed only when a class credit or valid subscription has "
"been applied."
msgstr ""
"Una reserva se confirma únicamente cuando se aplica un crédito de clase o "
"una suscripción válida."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid ""
"The Studio reserves the right to cancel or reschedule a class with "
"reasonable notice. In such cases, any used credit will be returned."
msgstr ""
"El Estudio se reserva el derecho de cancelar o reprogramar una clase con "
"aviso razonable. En estos casos, se devolverá cualquier crédito utilizado."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid ""
"Maximum occupancy per class is set by the Studio; once full, a waiting-list "
"may be offered at the Studio's discretion."
msgstr ""
"La ocupación máxima por clase la establece el Estudio; una vez completa, "
"puede ofrecerse una lista de espera a criterio del Estudio."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid "4. Cancellation Policy"
msgstr "4. Política de cancelación"

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid ""
"<strong>You must cancel at least 2 hours before the scheduled class start "
"time</strong> to have your credit returned."
msgstr ""
"<strong>Debes cancelar al menos 2 horas antes de la hora de inicio "
"programada de la clase</strong> para que se devuelva tu crédito."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid ""
"Cancellations made within 2 hours of the class, or no-shows, will result in "
"the full credit deduction with no refund."
msgstr ""
"Las cancelaciones realizadas dentro de las 2 horas previas a la clase, o las"
" ausencias, conllevarán la deducción del crédito completo sin reembolso."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid ""
"To cancel, use the \"Upcoming Classes\" section in your portal before the "
"cut-off time."
msgstr ""
"Para cancelar, utiliza la sección \"Próximas clases\" de tu portal antes del"
" plazo límite."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid ""
"The Studio may waive the policy in exceptional circumstances (medical "
"emergency, etc.) at its sole discretion. Contact us as soon as possible if "
"this applies."
msgstr ""
"El Estudio puede hacer una excepción a esta política en circunstancias "
"extraordinarias (emergencia médica, etc.) a su entera discreción. "
"Contáctanos lo antes posible si es tu caso."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid "5. Credit Policy"
msgstr "5. Política de créditos"

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid ""
"Credits are valid for the duration stated at the time of purchase. Expired "
"credits are non-refundable."
msgstr ""
"Los créditos son válidos durante el período indicado en el momento de la "
"compra. Los créditos caducados no son reembolsables."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid "Credits are personal and may not be transferred to another account."
msgstr "Los créditos son personales y no pueden transferirse a otra cuenta."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid "Credit balances are viewable in your portal under \"Balance\"."
msgstr ""
"El saldo de créditos se puede consultar en el portal, en la sección "
"\"Saldo\"."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid ""
"The Studio reserves the right to correct any credit balance errors (over- or"
" under-credited) with prior notice to the account holder."
msgstr ""
"El Estudio se reserva el derecho de corregir cualquier error en el saldo de "
"créditos (exceso o defecto) con previo aviso al titular de la cuenta."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid "6. Payments &amp; Refunds"
msgstr "6. Pagos y reembolsos"

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid ""
"All prices are stated in the currency displayed on the Studio's portal and "
"are inclusive of applicable taxes unless stated otherwise."
msgstr ""
"Todos los precios se expresan en la moneda mostrada en el portal del Estudio"
" e incluyen los impuestos aplicables, salvo que se indique lo contrario."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid ""
"Credit packages are non-refundable once purchased, except where required by "
"applicable consumer-protection law."
msgstr ""
"Los bonos de créditos no son reembolsables una vez comprados, excepto cuando"
" lo exija la legislación de protección al consumidor aplicable."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid ""
"Subscription fees are charged on a recurring basis as described at the time "
"of sign-up. You may cancel your subscription at any time; the cancellation "
"takes effect at the end of the current billing cycle."
msgstr ""
"Las cuotas de suscripción se cobran de forma periódica según lo indicado en "
"el momento del alta. Puedes cancelar tu suscripción en cualquier momento; la"
" cancelación surtirá efecto al final del ciclo de facturación en curso."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid ""
"The Studio does not store full payment card details; all payments are "
"processed via a PCI-DSS-compliant payment provider."
msgstr ""
"El Estudio no almacena datos completos de tarjetas de pago; todos los pagos "
"son procesados por un proveedor de pagos con certificación PCI-DSS."

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid "7. Health &amp; Liability"
msgstr "7. Salud y responsabilidad"

#. module: fitness_portal
#: model_terms:ir.ui.view,arch_db:fitness_portal.portal_terms
msgid ""
"Participation in Pilates and fitness classes carries inherent risk. You "
"confirm that you are in adequate physical condition to participate and that "
