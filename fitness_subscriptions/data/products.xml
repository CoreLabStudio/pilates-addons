<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--  MATRICULA (one-off registration fee)                           -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <!-- Charged once, on a student's first membership, and waived when
             they commit to three months or more. sale_ok is False: it is never
             something a student picks off the shop, only a line the membership
             checkout adds for them. recurring_invoice stays off so it is
             billed once rather than every period. -->
        <record id="product_matricula" model="product.template">
            <field name="name">Registration (Matrícula)</field>
            <field name="type">service</field>
            <field name="list_price">39.00</field>
            <field name="sale_ok" eval="False"/>
            <field name="purchase_ok" eval="False"/>
            <field name="fitness_is_matricula">1</field>
            <field name="description_sale">One-off registration fee, charged with your first membership.</field>
        </record>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!--  REFORMER MENSUAL (metered monthly bucket)                      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->

        <!-- fitness_is_reformer_mensual=1: auto-grants +1 floating credit when
             confirmed within the studio promo window (Sept–Nov 2026), same as
             Barre Clase Fija. fitness_promo_first_cycle_bonus stays 0 so the
             action_confirm() date gate does not block year-round sales. -->
        <record id="product_reformer_mensual_1" model="product.template">
            <field name="name">Reformer Mensual 1 (Promo de apertura)</field>
            <field name="type">service</field>
            <field name="list_price">70.00</field>
            <field name="recurring_invoice">1</field>
            <field name="fitness_is_subscription_plan">1</field>
            <field name="fitness_subscription_plan_id" ref="sale_subscription.subscription_plan_month"/>
            <field name="fitness_is_reformer_mensual">1</field>
            <field name="weekly_class_allowance">1</field>
            <field name="fitness_promo_first_cycle_bonus">0</field>
            <field name="monthly_class_allowance">4</field><!-- legacy value; reporting-only -->
            <field name="is_unlimited">0</field>
            <field name="fitness_class_type">reformer</field>
            <field name="fitness_session_type">group</field>
            <field name="description_sale">One Reformer class every week, on your own recurring day and time. A steady rhythm without the commitment of more.</field>
        </record>

