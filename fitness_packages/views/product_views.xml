<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Standalone list for the Packages menu (filtered product.template).
         Mirrors fitness_subscriptions' Subscription Plans list.

         Why this exists: Catalog > Packages previously opened
         action_fitness_packages, whose res_model is sale.order — it listed
         package SALES, not the package PRODUCTS. That left no way anywhere in
         the backend to open a package product, which is why it had no image
         upload while Subscription Plans did. The product form already carries
         image_1920 from the stock view; it simply was not reachable. -->
    <record id="view_product_template_packages_list" model="ir.ui.view">
        <field name="name">product.template.packages.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="image_128" widget="image" width="48px" options="{'size': [48, 48]}"/>
                <field name="name" string="Package Name"/>
                <field name="fitness_class_type" string="Studio"
                       widget="badge"
                       decoration-info="fitness_class_type == 'barre'"
                       decoration-success="fitness_class_type == 'reformer'"/>
                <field name="fitness_session_type" string="Session"/>
                <field name="fitness_class_count" string="Classes"/>
                <field name="fitness_validity_days" string="Validity (days)"/>
                <field name="list_price" string="Full Price" optional="show"/>
                <!-- Which products are on offer, without opening each one. -->
                <field name="fitness_promo_summary" string="Promotion"
                       decoration-success="fitness_promo_is_live"
                       optional="show"/>
                <field name="fitness_price_now" string="Price Today" optional="show"/>
                <field name="fitness_promo_is_live" column_invisible="True"/>
                <field name="sale_ok" string="Can be Sold" widget="boolean" optional="hide"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Action: Packages (product.template). view_mode list,form so the form
         falls through to the stock product form, which already provides the
         image_1920 upload widget. -->
    <record id="action_fitness_package_products" model="ir.actions.act_window">
        <field name="name">Packages</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_product_template_packages_list"/>
        <field name="domain">[('fitness_is_package', '=', True)]</field>
        <field name="context">{'default_fitness_is_package': True, 'active_test': False}</field>
    </record>

    <!-- Add Fitness Package tab to product form -->
    <record id="view_product_template_form_fitness" model="ir.ui.view">
        <field name="name">product.template.form.fitness</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Fitness Package" name="fitness_package">
                    <group>
                        <group string="Package Settings">
                            <field name="fitness_is_package"/>
                            <field name="fitness_class_count"
                                   invisible="not fitness_is_package"/>
                            <field name="fitness_validity_days"
                                   invisible="not fitness_is_package"/>
                        </group>
                        <group string="Restrictions" invisible="not fitness_is_package">
                            <field name="fitness_class_type"/>
                            <field name="fitness_session_type"/>
                        </group>
                    </group>
                    <!-- Set the offer here rather than editing the sales price.
                         The sales price stays the real price; this decides what
                         is charged while the window is open, and the window
                         closing is what ends the offer - there is nothing to
                         put back afterwards. -->
                    <group string="Promotion" invisible="not fitness_is_package">
                        <group>
                            <field name="fitness_promo_mode" widget="radio"/>
                            <field name="fitness_promo_percent"
                                   invisible="fitness_promo_mode != 'percent'"
                                   required="fitness_promo_mode == 'percent'"/>
                            <field name="fitness_promo_start"
                                   invisible="fitness_promo_mode == 'none'"/>
                            <field name="fitness_promo_end"
                                   invisible="fitness_promo_mode == 'none'"/>
                        </group>
                        <group string="What a student pays today">
                            <field name="fitness_promo_summary" readonly="1"/>
                            <field name="fitness_price_now" readonly="1"
                                   widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="fitness_promo_saving" readonly="1"
                                   invisible="not fitness_promo_is_live"
                                   widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            <field name="fitness_promo_is_live" invisible="1"/>
                            <div class="text-muted" colspan="2"
                                 invisible="fitness_promo_mode == 'none'">
                                Outside the dates above the product sells at its
                                full sales price again, automatically.
                            </div>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
