<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         CLASS REPORT — fitness.report.class (SQL view)
         Replaces the old calendar.event view; now exposes
         occupancy_pct, attended / no-show / cancelled counts.
         ═══════════════════════════════════════════════════════════ -->

    <!-- LIST ─────────────────────────────────────────────────── -->
    <record id="view_fitness_class_report_list" model="ir.ui.view">
        <field name="name">fitness.report.class.classes.list</field>
        <field name="model">fitness.report.class</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" default_order="class_date desc">
                <field name="class_date"      string="Date"/>
                <field name="event_id"        string="Class"/>
                <field name="teacher_user_id" string="Instructor"/>
                <field name="class_type_id"   string="Type"/>
                <field name="capacity"        string="Capacity"         sum="Total aforo"/>
                <field name="booked_count"    string="Bookings"      sum="Total"/>
                <field name="attended_count"  string="Attended"     sum="Total"/>
                <field name="no_show_count"   string="No-shows" sum="Total"/>
                <field name="cancelled_count" string="Cancelled"    sum="Total"/>
                <field name="occupancy_pct"   string="Occupancy %"/>
            </list>
        </field>
    </record>

    <!-- PIVOT ────────────────────────────────────────────────── -->
    <record id="view_fitness_class_report_pivot" model="ir.ui.view">
        <field name="name">fitness.report.class.classes.pivot</field>
        <field name="model">fitness.report.class</field>
        <field name="arch" type="xml">
            <pivot string="Classes Taught">
                <field name="class_date"      type="row" interval="month"/>
                <field name="teacher_user_id" type="row"/>
                <field name="class_type_id"   type="col"/>
                <field name="booked_count"    type="measure"/>
                <field name="attended_count"  type="measure"/>
                <field name="occupancy_pct"   type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- GRAPH ────────────────────────────────────────────────── -->
    <record id="view_fitness_class_report_graph" model="ir.ui.view">
        <field name="name">fitness.report.class.classes.graph</field>
        <field name="model">fitness.report.class</field>
        <field name="arch" type="xml">
            <graph string="Classes by Instructor" type="bar">
                <field name="teacher_user_id" type="row"/>
                <field name="class_type_id"   type="col"/>
                <field name="booked_count"    type="measure"/>
            </graph>
        </field>
    </record>

    <!-- SEARCH ───────────────────────────────────────────────── -->
    <record id="view_fitness_class_report_search" model="ir.ui.view">
        <field name="name">fitness.report.class.classes.search</field>
        <field name="model">fitness.report.class</field>
        <field name="arch" type="xml">
            <search string="Search Classes">
                <field name="event_id"        string="Class"/>
                <field name="teacher_user_id" string="Instructor"/>
                <field name="class_type_id"   string="Class Type"/>
                <separator/>
                <!-- B5: visible date-range chips -->
                <filter name="filter_this_month"
                        string="This Month"
                        domain="[('class_date','&gt;=', (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d')),
                                 ('class_date','&lt;',  (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_last_month"
                        string="Last Month"
                        domain="[('class_date','&gt;=', (context_today() + relativedelta(months=-1, day=1)).strftime('%Y-%m-%d')),
                                 ('class_date','&lt;',  (context_today() + relativedelta(day=1)).strftime('%Y-%m-%d'))]"/>
                <filter name="filter_this_year"
                        string="This Year"
                        domain="[('class_date','&gt;=', context_today().strftime('%Y-01-01')),
                                 ('class_date','&lt;',  (context_today() + relativedelta(years=1, month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group>
                    <filter name="group_instructor"
                            string="Instructor"
                            context="{'group_by':'teacher_user_id'}"/>
                    <filter name="group_class_type"
                            string="Class Type"
                            context="{'group_by':'class_type_id'}"/>
                    <filter name="group_month"
                            string="Month"
                            context="{'group_by':'class_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION — Classes ─────────────────────────────────────── -->
    <record id="action_fitness_class_report" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">fitness.report.class</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_fitness_class_report_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_fitness_class_report_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_fitness_class_report_graph')}),
            (0, 0, {'view_mode': 'list',  'view_id': ref('view_fitness_class_report_list')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay clases que mostrar.
            </p>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         TEAM REPORT (B2) — fitness.report.class grouped by instructor
         ═══════════════════════════════════════════════════════════ -->

    <!-- PIVOT — Team ─────────────────────────────────────────── -->
    <record id="view_fitness_team_report_pivot" model="ir.ui.view">
        <field name="name">fitness.report.class.team.pivot</field>
        <field name="model">fitness.report.class</field>
        <field name="arch" type="xml">
            <pivot string="Instructor Performance">
                <field name="teacher_user_id" type="row"/>
                <field name="class_date"      type="col" interval="month"/>
                <field name="booked_count"    type="measure"/>
                <field name="attended_count"  type="measure"/>
                <field name="occupancy_pct"   type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- GRAPH — Team ─────────────────────────────────────────── -->
    <record id="view_fitness_team_report_graph" model="ir.ui.view">
        <field name="name">fitness.report.class.team.graph</field>
        <field name="model">fitness.report.class</field>
        <field name="arch" type="xml">
            <graph string="Attendance by Instructor" type="bar">
                <field name="teacher_user_id" type="row"/>
                <field name="class_date"      type="col" interval="month"/>
                <field name="attended_count"  type="measure"/>
            </graph>
        </field>
    </record>

    <!-- ACTION — Team ────────────────────────────────────────── -->
    <record id="action_fitness_team_report" model="ir.actions.act_window">
        <field name="name">Instructor Stats</field>
        <field name="res_model">fitness.report.class</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_fitness_class_report_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_fitness_team_report_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_fitness_team_report_graph')}),
            (0, 0, {'view_mode': 'list',  'view_id': ref('view_fitness_class_report_list')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay clases registradas para este instructor.
            </p>
        </field>
    </record>

</odoo>
