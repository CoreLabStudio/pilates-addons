<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         CLIENT REPORT — fitness.report.client (SQL view)
         One row per partner with confirmed package order or booking.
         ═══════════════════════════════════════════════════════════ -->

    <!-- LIST ─────────────────────────────────────────────────── -->
    <record id="view_fitness_report_client_list" model="ir.ui.view">
        <field name="name">fitness.report.client.list</field>
        <field name="model">fitness.report.client</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" default_order="partner_id asc"
                  decoration-success="is_active_client"
                  decoration-muted="not is_active_client">
                <field name="partner_id"             string="Student"/>
                <field name="is_active_client"       string="Activo"/>
                <field name="first_order_date"       string="1er Pedido"/>
                <field name="total_revenue"          string="Ingresos ex-IVA (EUR)"
                       sum="Total"/>
                <field name="attended_classes"       string="Clases asistidas" sum="Total"/>
                <field name="avg_classes_per_month"  string="Media / mes"/>
                <field name="last_attended_date"     string="Última asistencia"/>
                <field name="active_subscriptions"   string="Suscripciones activas"/>
                <field name="active_package_credits" string="Créditos de pack"/>
            </list>
        </field>
    </record>

    <!-- PIVOT ────────────────────────────────────────────────── -->
    <record id="view_fitness_report_client_pivot" model="ir.ui.view">
        <field name="name">fitness.report.client.pivot</field>
        <field name="model">fitness.report.client</field>
        <field name="arch" type="xml">
            <pivot string="Clientes">
                <field name="first_order_date" type="row" interval="month"/>
                <field name="is_active_client" type="col"/>
                <field name="total_revenue"    type="measure"/>
                <field name="attended_classes" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- GRAPH ────────────────────────────────────────────────── -->
    <record id="view_fitness_report_client_graph" model="ir.ui.view">
        <field name="name">fitness.report.client.graph</field>
        <field name="model">fitness.report.client</field>
        <field name="arch" type="xml">
            <graph string="Ingresos por cliente" type="bar">
                <field name="partner_id"    type="row"/>
                <field name="total_revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- SEARCH ───────────────────────────────────────────────── -->
    <record id="view_fitness_report_client_search" model="ir.ui.view">
        <field name="name">fitness.report.client.search</field>
        <field name="model">fitness.report.client</field>
        <field name="arch" type="xml">
            <search string="Buscar clientes">
                <field name="partner_id"/>
                <separator/>
                <!-- B5: date range chips on first order -->
                <filter name="filter_first_order_this_year"
                        string="Primer pedido este año"
                        domain="[('first_order_date','&gt;=', context_today().strftime('%Y-01-01')),
                                 ('first_order_date','&lt;',  (context_today() + relativedelta(years=1, month=1, day=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="filter_active"
                        string="Clientes activos"
                        domain="[('is_active_client','=',True)]"/>
                <filter name="filter_inactive"
                        string="Clientes inactivos"
                        domain="[('is_active_client','=',False)]"/>
                <separator/>
                <group>
                    <filter name="group_partner"
                            string="Student"
                            context="{'group_by':'partner_id'}"/>
                    <filter name="group_first_order_month"
                            string="Mes primer pedido"
                            context="{'group_by':'first_order_date:month'}"/>
                    <filter name="group_active"
                            string="Estado (activo)"
                            context="{'group_by':'is_active_client'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ACTION ───────────────────────────────────────────────── -->
    <record id="action_fitness_client_report" model="ir.actions.act_window">
        <field name="name">Clients</field>
        <field name="res_model">fitness.report.client</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="search_view_id" ref="view_fitness_report_client_search"/>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('view_fitness_report_client_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('view_fitness_report_client_graph')}),
            (0, 0, {'view_mode': 'list',  'view_id': ref('view_fitness_report_client_list')}),
        ]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay clientes con actividad registrada.
            </p>
        </field>
    </record>

</odoo>
