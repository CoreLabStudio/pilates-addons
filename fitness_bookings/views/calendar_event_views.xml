<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Adds "Cancel Entire Class" to the calendar event form header.
         Only visible to managers when the event is a fitness class. -->
    <record id="view_calendar_event_form_cancel_class" model="ir.ui.view">
        <field name="name">calendar.event.form.cancel_class</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_cancel_class"
                        string="Cancel Entire Class"
                        type="object"
                        class="btn-danger"
                        groups="fitness_core.group_fitness_manager"
                        invisible="not is_fitness_class or class_state == 'cancelled'"
                        confirm="This will cancel ALL active bookings and return credits to students. Continue?"/>
            </xpath>
        </field>
    </record>

    <!-- The roster, on the class itself. Cancelling one student was only
         reachable from the student's side before, which is the wrong way round
         when somebody rings the studio about a class: the desk is looking at
         the class, not hunting for the person. Same wizard either way. -->
    <record id="view_calendar_event_form_roster" model="ir.ui.view">
        <field name="name">calendar.event.form.roster</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">
            <!-- First page, not appended last. Opening a class from the
                 Schedule is nearly always about who is in it - taking the
                 register, checking a name, moving somebody - and Notes was
                 landing first, so every visit started with a tab nobody
                 wanted and a click to get past it. "inside" put this at the
                 end of the notebook; "before" the first page makes it the
                 one that opens. -->
            <xpath expr="//notebook/page[1]" position="before">
                <page string="Roster" name="fitness_roster"
                      groups="fitness_core.group_fitness_manager"
                      invisible="not is_fitness_class">
                    <field name="booking_ids" nolabel="1" readonly="1">
                        <list create="false" delete="false"
                              decoration-muted="state == 'cancelled'"
                              decoration-success="state == 'attended'">
                            <field name="student_id"/>
                            <field name="booking_date"/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'booked'"
                                   decoration-success="state == 'attended'"
                                   decoration-danger="state == 'cancelled'"
                                   decoration-warning="state == 'no_show'"/>
                            <field name="credit_returned" optional="show"/>
                            <button name="action_open_reassign_wizard" type="object"
                                    string="Cancel / Move" icon="fa-exchange"
                                    invisible="state != 'booked'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- ── Cancel / restore from the Schedule list ──────────────────────────
         Tick the rows, Actions, choose one. Deliberately alongside Odoo's
         Archive rather than instead of it: Archive hides a row and tells
         nobody, which is what closing a recurring slot does to the classes it
         generated. Cancelling calls the class off - bookings cancelled,
         credits returned, students told. Naming both plainly is the only way
         the two stop being confused. -->
    <record id="action_calendar_event_cancel_classes" model="ir.actions.server">
        <field name="name">Cancel classes</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="binding_model_id" ref="calendar.model_calendar_event"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_cancel_classes_bulk()</field>
    </record>

    <record id="action_calendar_event_restore_classes" model="ir.actions.server">
        <field name="name">Put classes back</field>
        <field name="model_id" ref="calendar.model_calendar_event"/>
        <field name="binding_model_id" ref="calendar.model_calendar_event"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">action = records.action_restore_classes()</field>
    </record>

</odoo>
