<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Cancel several classes at once ───────────────────────────────────
         The snow-day screen. Cancelling a day used to mean opening each class
         in turn, with no idea how many students it added up to until it was
         over. -->
    <record id="view_fitness_bulk_cancel_wizard_form" model="ir.ui.view">
        <field name="name">fitness.class.bulk.cancel.wizard.form</field>
        <field name="model">fitness.class.bulk.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel classes">
                <sheet>
                    <group>
                        <field name="day"/>
                    </group>
                    <!-- Said before anything is ticked, so the size of the day
                         is known before the decision, not after it. -->
                    <div class="alert alert-info mb-2" role="status"
                         invisible="not day_summary">
                        <field name="day_summary" nolabel="1" readonly="1"/>
                    </div>

                    <field name="selected_count" invisible="1"/>
                    <group string="Which classes are off?">
                        <!-- The day arrives already listed: only the tick box
                             is editable, because every other column is read
                             off the class and must not drift from it. -->
                        <field name="line_ids" nolabel="1" colspan="2">
                            <list editable="bottom" create="false" delete="false">
                                <field name="selected" widget="boolean_toggle"/>
                                <field name="start" string="Time" readonly="1"/>
                                <field name="name" string="Class" readonly="1"/>
                                <field name="classroom_id" string="Studio" readonly="1"/>
                                <field name="teacher_id" string="Instructor" readonly="1"/>
                                <field name="booked_seats" string="Booked"
                                       readonly="1" sum="Students"/>
                                <field name="capacity" string="Capacity" readonly="1"/>
                            </list>
                        </field>
                    </group>
                    <div class="mb-2">
                        <button name="action_select_all" type="object"
                                string="Select every class that day"
                                class="btn btn-link btn-sm"
                                invisible="not line_ids"/>
                        <button name="action_select_none" type="object"
                                string="Clear the selection"
                                class="btn btn-link btn-sm"
                                invisible="selected_count == 0"/>
                    </div>

                    <!-- Optional, and it reaches the students: the same
                         message they already get, with the studio's words on
                         the end. -->
                    <group string="Reason (optional)">
                        <field name="reason" nolabel="1" colspan="2"
                               placeholder="e.g. The studio is closed today because of the storm."/>
                    </group>

                    <!-- What is about to happen, in students rather than in
                         rows. This is the number worth reading twice. -->
                    <div class="alert alert-warning mb-0" role="alert"
                         invisible="not selection_summary">
                        <field name="selection_summary" nolabel="1" readonly="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_cancel_selected" type="object"
                            string="Cancel these classes" class="btn-danger"
                            invisible="selected_count == 0"
                            confirm="This cancels the classes and every booking on them, and tells the students. Go ahead?"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fitness_bulk_cancel" model="ir.actions.act_window">
        <field name="name">Cancel Classes</field>
        <field name="res_model">fitness.class.bulk.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_fitness_bulk_cancel"
              name="Cancel Classes"
              parent="fitness_core.menu_fitness_classes_root"
              action="action_fitness_bulk_cancel"
              sequence="30"/>

</odoo>
