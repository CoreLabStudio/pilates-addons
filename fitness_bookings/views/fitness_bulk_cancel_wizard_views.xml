<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Manage a day of classes ──────────────────────────────────────────
         The snow-day screen, and the morning-after screen. Calling a day off
         used to mean opening each class in turn, with no idea how many
         students it added up to until it was over - and putting one back
         meant finding it somewhere else entirely. Both directions live here
         now, on the day, so changing your mind happens where the decision
         was made. -->
    <record id="view_fitness_bulk_cancel_wizard_form" model="ir.ui.view">
        <field name="name">fitness.class.bulk.cancel.wizard.form</field>
        <field name="model">fitness.class.bulk.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Manage classes">
                <sheet>
                    <group>
                        <field name="day"/>
                    </group>
                    <!-- Said before anything is moved, so the size of the day
                         is known before the decision, not after it. -->
                    <div class="alert alert-info mb-2" role="status"
                         invisible="not day_summary">
                        <field name="day_summary" nolabel="1" readonly="1"/>
                    </div>

                    <field name="change_count" invisible="1"/>
                    <group string="Which classes are on?">
                        <!-- The day arrives already listed, every class on it
                             running or cancelled, each switch showing what the
                             class is now. Only the switch is editable, because
                             every other column is read off the class and must
                             not drift from it. -->
                        <field name="line_ids" nolabel="1" colspan="2">
                            <list editable="bottom" create="false" delete="false"
                                  decoration-muted="class_state == 'cancelled'">
                                <!-- Carried, not shown, and force_save because
                                     it is readonly. A wizard that has never
                                     been stored saves its lines as creates,
                                     and event_id is required on them - but
                                     Odoo drops readonly fields from the save
                                     payload unless they are forced. Without
                                     this the dialog failed on every attempt
                                     with "Missing required value for the
                                     field 'Event'" and nothing could be
                                     cancelled at all. Naming the field in the
                                     view is not enough on its own; that was
                                     tried and failed the same way. -->
                                <field name="event_id" column_invisible="1"
                                       force_save="1"/>
                                <field name="is_on" widget="boolean_toggle"/>
                                <field name="start" readonly="1"/>
                                <field name="name" readonly="1"/>
                                <!-- Stated as well as implied by the dimming:
                                     the switch shows what you are asking for,
                                     this shows what the class still is until
                                     Apply. -->
                                <field name="class_state"
                                       widget="badge" readonly="1"
                                       decoration-success="class_state == 'scheduled'"
                                       decoration-danger="class_state == 'cancelled'"/>
                                <field name="classroom_id" readonly="1"/>
                                <field name="teacher_id" readonly="1"/>
                                <field name="booked_seats"
                                       readonly="1" sum="Students"/>
                                <field name="capacity" readonly="1"/>
                            </list>
                        </field>
                    </group>
                    <div class="mb-2">
                        <button name="action_select_all" type="object"
                                string="Switch the whole day off"
                                class="btn btn-link btn-sm"
                                invisible="not line_ids"/>
                        <button name="action_select_none" type="object"
                                string="Put the whole day back on"
                                class="btn btn-link btn-sm"
                                invisible="not line_ids"/>
                    </div>

                    <!-- Optional, and it reaches the students: the same
                         message they already get, with the studio's words on
                         the end. -->
                    <group string="Reason (optional)">
                        <field name="reason" nolabel="1" colspan="2"
                               placeholder="e.g. The studio is closed today because of the storm."/>
                    </group>

                    <!-- What is about to happen, in students rather than in
                         rows. This is the number worth reading twice. -->
                    <div class="alert alert-warning mb-0" role="alert"
                         invisible="not selection_summary">
                        <field name="selection_summary" nolabel="1" readonly="1"/>
                    </div>
                </sheet>
                <footer>
                    <button name="action_apply" type="object"
                            string="Apply changes" class="btn-primary"
                            invisible="change_count == 0"
                            confirm="This changes the classes you switched and tells the students. Go ahead?"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fitness_bulk_cancel" model="ir.actions.act_window">
        <field name="name">Manage Classes</field>
        <field name="res_model">fitness.class.bulk.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_fitness_bulk_cancel"
              name="Manage Classes"
              parent="fitness_core.menu_fitness_classes_root"
              action="action_fitness_bulk_cancel"
              sequence="30"/>

</odoo>
