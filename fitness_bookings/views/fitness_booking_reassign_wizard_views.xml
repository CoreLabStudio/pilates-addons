<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fitness_booking_reassign_wizard_form" model="ir.ui.view">
        <field name="name">fitness.booking.reassign.wizard.form</field>
        <field name="model">fitness.booking.reassign.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel or move students">
                <sheet>
                    <field name="booking_count" invisible="1"/>
                    <!-- One student: read as before. Several: name them, because
                         the whole failure this fixes was a desk believing it
                         had acted on five when it had acted on one. -->
                    <group invisible="booking_count > 1">
                        <field name="student_id"/>
                        <field name="from_event_id"/>
                        <field name="from_start"/>
                    </group>
                    <group invisible="booking_count &lt;= 1" string="Students selected">
                        <field name="booking_ids" nolabel="1" colspan="2" readonly="1">
                            <list>
                                <field name="student_id"/>
                                <field name="calendar_event_id" string="Leaving"/>
                                <field name="state"/>
                            </list>
                        </field>
                    </group>
                    <!-- Only a cancellation can return a credit. During a
                         move nothing is returned or re-spent - the booking
                         keeps the credit it already has - so offering the
                         choice here only invited the question "if I'm moving
                         them, why would I give the credit back?". -->
                    <group invisible="target_event_id">
                        <field name="restore_credit"/>
                    </group>
                    <!-- Optional on purpose. A student who wants a refund and
                         no replacement is cancelled with the left-hand button
                         and never sees this field matter. -->
                    <group string="Move them instead (optional)">
                        <field name="available_event_ids" invisible="1"/>
                        <field name="target_event_id"
                               options="{'no_create': True, 'no_open': True}"
                               placeholder="Leave empty to cancel without moving them"/>
                    </group>
                    <!-- Optional, and it applies to both outcomes: the
                         student is told either way, and a sentence from the
                         studio reads better than a bare notification. -->
                    <group string="Reason (optional)">
                        <field name="reason" nolabel="1" colspan="2"
                               placeholder="e.g. Moving you to the later class so the group can run."/>
                    </group>
                </sheet>
                <footer>
                    <button string="Cancel Only" type="object"
                            name="action_cancel_only" class="btn-danger"
                            invisible="target_event_id"/>
                    <button string="Move" type="object"
                            name="action_move_student" class="btn-primary"
                            invisible="not target_event_id"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fitness_booking_reassign" model="ir.actions.act_window">
        <field name="name">Cancel or move students</field>
        <field name="res_model">fitness.booking.reassign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_fitness_booking"/>
        <field name="binding_view_types">list,form</field>
        <!-- active_ids, not active_id. The singular form opened the wizard on
             whichever booking happened to be first and silently dropped the
             rest of the selection, so cancelling five students cancelled one
             and the desk had no way to tell. -->
        <field name="context">{'default_booking_ids': active_ids}</field>
    </record>

</odoo>
