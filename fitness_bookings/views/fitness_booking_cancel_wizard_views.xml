<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fitness_booking_cancel_wizard_form" model="ir.ui.view">
        <field name="name">fitness.booking.cancel.wizard.form</field>
        <field name="model">fitness.booking.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Booking (Late)">
                <sheet>
                    <div class="alert alert-warning mb-3" role="alert">
                        This class starts in less than 2 hours.
                        Late cancellations do not automatically return credits.
                    </div>
                    <group>
                        <field name="student_name"/>
                        <field name="class_name"/>
                        <field name="class_start"/>
                    </group>
                    <group>
                        <field name="restore_credit"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Cancel Booking" type="object"
                            name="action_confirm" class="btn-danger"/>
                    <button string="Discard" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
