<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fitness_booking_mark_wizard_form" model="ir.ui.view">
        <field name="name">fitness.booking.mark.wizard.form</field>
        <field name="model">fitness.booking.mark.wizard</field>
        <field name="arch" type="xml">
            <form string="Correct the attendance mark">
                <sheet>
                    <div class="alert alert-info mb-3" role="alert"
                         invisible="kind == 'cancel'">Changing the mark changes the record only. The credit was spent when she booked, and stays spent either way.</div>
                    <group>
                        <field name="kind" invisible="1"/>
                        <field name="student_name"/>
                        <field name="class_name"/>
                        <field name="class_start"/>
                        <field name="current_state"/>
                    </group>
                    <group invisible="kind != 'cancel'">
                        <field name="return_credit"/>
                    </group>
                    <group string="Why">
                        <field name="reason" nolabel="1" colspan="2"
                               required="1"
                               placeholder="e.g. Marked absent by mistake - she was in the room."/>
                    </group>
                </sheet>
                <footer>
                    <button string="Confirm" type="object"
                            name="action_confirm" class="btn-primary"/>
                    <button string="Discard" special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
