#. module: fitness_notifications
#. odoo-python
#: code:addons/fitness_notifications/models/fitness_booking.py:0
#, python-format
msgid "1 credit used for %s"
msgstr "1 crèdit usat per a %s"

#. module: fitness_notifications
#. odoo-python
#: code:addons/fitness_notifications/models/fitness_booking.py:0
#, python-format
msgid "%d credit(s) remaining in this pack."
msgstr "%d crèdit(s) restant(s) en aquest bo."

#. module: fitness_notifications
#. odoo-python
#: code:addons/fitness_notifications/models/fitness_booking.py:0
msgid "No credits remaining"
msgstr "Sense crèdits restants"

#. module: fitness_notifications
#. odoo-python
#: code:addons/fitness_notifications/models/fitness_booking.py:0
msgid "You have used your last credit. Visit Packages to purchase more."
msgstr "Has usat el teu últim crèdit. Visita Bons per comprar-ne més."

#. module: fitness_notifications
#. odoo-python
#: code:addons/fitness_notifications/models/fitness_booking.py:0
#, python-format
msgid "Only %d credit(s) left"
msgstr "Només queden %d crèdit(s)"

#. module: fitness_notifications
#. odoo-python
#: code:addons/fitness_notifications/models/fitness_booking.py:0
msgid "Running low on credits. Browse packages to top up."
msgstr "Crèdits baixos. Explora els bons per recarregar."

#. module: fitness_notifications
#. odoo-python
#: code:addons/fitness_notifications/models/fitness_booking.py:0
#, python-format
msgid "%d credit(s) expiring in %d day(s)"
msgstr "%d crèdit(s) caduquen en %d dia(s)"

#. module: fitness_notifications
#. odoo-python
#: code:addons/fitness_notifications/models/fitness_booking.py:0
#, python-format
msgid "Your pack expires on %s. Use your remaining credits before they expire."
msgstr "El teu bo caduca el %s. Usa els teus crèdits restants abans que caduquin."

#. module: fitness_notifications
#. odoo-python
#: code:addons/fitness_notifications/models/fitness_booking.py:0
#, python-format
msgid "Subscription renews in %d days"
msgstr "La subscripció es renova en %d dies"

#. module: fitness_notifications
#. odoo-python
#: code:addons/fitness_notifications/models/fitness_booking.py:0
#, python-format
msgid "Your %s plan renews on %s. No action needed."
msgstr "El teu pla %s es renova el %s. No cal que facis res."

#. module: fitness_notifications
#. odoo-python
#: code:addons/fitness_notifications/models/fitness_booking.py:0
#, python-format
msgid "Booking confirmed: %(cls)s"
msgstr "Reserva confirmada: %(cls)s"

#. module: fitness_notifications
#. odoo-python
#: code:addons/fitness_notifications/models/fitness_booking.py:0
#, python-format
msgid "Your place is booked for %(cls)s on %(when)s."
msgstr "La teva plaça està reservada per a %(cls)s el %(when)s."

#. module: fitness_notifications
#. odoo-python
#: code:addons/fitness_notifications/models/fitness_booking.py:0
#, python-format
msgid "Your place is booked for %(cls)s."
msgstr "La teva plaça està reservada per a %(cls)s."
