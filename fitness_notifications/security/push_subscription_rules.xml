<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- The access rows grant portal and internal users read and write on
             fitness.push.subscription, and their names say "own device" - but
             nothing made that true. An ir.model.access line is a permission on
             the MODEL; limiting it to the rows somebody owns takes a record
             rule, and there was none. So any logged-in student could read
             every other student's subscriptions, endpoints included.

             Nothing in the UI showed it, because a student is only ever shown
             her own device, which is exactly why it survived: the screens all
             looked right. A test asking the question directly is what found
             it.

             An endpoint is a bearer capability - whoever holds one can push to
             that phone - so this is the difference between a private row and a
             shared one. -->

        <record id="rule_push_subscription_own_portal" model="ir.rule">
            <field name="name">Push subscription: a student sees only her own devices</field>
            <field name="model_id" ref="model_fitness_push_subscription"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>

        <!-- Teachers and other internal staff are not administrators of this.
             Same rule, separate record, because the two groups are separate
             grants and a single rule naming both would stop applying to either
             if one group were ever removed. -->
        <record id="rule_push_subscription_own_internal" model="ir.rule">
            <field name="name">Push subscription: internal users see only their own devices</field>
            <field name="model_id" ref="model_fitness_push_subscription"/>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>

        <!-- Record rules for the groups a user belongs to are OR'ed together,
             so a manager - who is also an internal user - gets this one as
             well and sees everything. That is deliberate: somebody has to be
             able to answer "is her phone registered at all?" when a student
             says notifications never arrive. -->
        <record id="rule_push_subscription_manager_all" model="ir.rule">
            <field name="name">Push subscription: a manager sees every device</field>
            <field name="model_id" ref="model_fitness_push_subscription"/>
            <field name="groups" eval="[(4, ref('fitness_core.group_fitness_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

    </data>
</odoo>
