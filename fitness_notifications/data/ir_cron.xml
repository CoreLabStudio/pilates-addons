<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="ir_cron_fitness_send_reminders" model="ir.cron">
            <field name="name">Fitness: Send Class Reminders</field>
            <field name="model_id" ref="fitness_bookings.model_fitness_booking"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_reminders()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Bell reminder: fires every 30 min, sends in-app notification 6–12h before class. -->
        <record id="ir_cron_fitness_send_bell_reminders" model="ir.cron">
            <field name="name">Fitness: Send Class Bell Reminders (6–12h)</field>
            <field name="model_id" ref="fitness_bookings.model_fitness_booking"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_bell_reminders()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

        <!-- Billing reminder: fires daily, notifies 3 days before subscription renewal.
             Lead time is hard-coded to 3 days (flagged for studio confirmation). -->
        <record id="ir_cron_fitness_billing_reminder" model="ir.cron">
            <field name="name">Fitness: Send Subscription Renewal Reminders</field>
            <field name="model_id" ref="fitness_bookings.model_fitness_booking"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_billing_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Teacher reminder: fires every 30 min, notifies the teacher ~2h before
             their class starts, flagging low attendance (<30% of capacity). -->
        <record id="ir_cron_teacher_class_reminder" model="ir.cron">
            <field name="name">Fitness: Teacher Class Reminders</field>
            <field name="model_id" ref="fitness_bookings.model_fitness_booking"/>
            <field name="state">code</field>
            <field name="code">model._cron_teacher_class_reminder()</field>
            <field name="interval_number">30</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>
